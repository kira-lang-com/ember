// The launch settings a harness gives a run: which frame to read back, where to
// write it, when to quit, and any scripted input.
//
// These were environment variables read once at init — KIRA_GRAPHICS_CAPTURE_FRAME,
// KIRA_GRAPHICS_CAPTURE_AT, KIRA_GRAPHICS_QUIT_AFTER_FRAMES, KIRA_GRAPHICS_RESIZE_SWEEP,
// KIRA_GRAPHICS_LOG_FPS, KIRA_GRAPHICS_SCALE, and the KIRA_UI_*_SCRIPT family. A caller that builds one
// hands the run its settings directly; a run given none reads the environment as
// before, so a driven run and an environment-driven run resolve to the same knobs.
public struct HarnessConfig {
    var quitAfterFrames: UNumber = 0
    var resizeSweep: UNumber = 0
    var logFps: Bool = false
    // The pixels the window draws for each point, where the run fixes them
    // rather than the display: 3 draws a phone's 3x screen on a 1x display.
    // Zero leaves them to the display.
    var scale: UNumber = 0
    var capture: FrameCapture? = .None
    var script: InputScript = InputScript()
}

// A frame to read back and the file to write it to. A frame left unset takes
// the last one drawn — the frame the run quits after — so a settle-then-shoot
// needs only a frame count and a path.
public struct FrameCapture {
    var path: String = ""
    var frame: UNumber? = .None
}
