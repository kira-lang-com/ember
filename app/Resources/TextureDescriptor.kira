public struct TextureDescriptor {
    var label: String = ""
    var width: UN32 = 1
    var height: UN32 = 1
    var format: TextureFormat = .Rgba8Unorm
    var usage: TextureUsage = .Sampled
    var sampleCount: UN8 = 1
    var storage: AttachmentStorage = .Persistent
}

public struct SamplerDescriptor {
    var label: String = ""
    var minFilter: TextureFilter = .Nearest
    var magFilter: TextureFilter = .Nearest
    var addressModeU: AddressMode = .ClampToEdge
    var addressModeV: AddressMode = .ClampToEdge
}
