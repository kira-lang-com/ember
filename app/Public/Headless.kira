import Foundation

// A graphics device with no window.
//
// Every runner in this library opens a window, because almost everything that
// draws has one. A COMPONENT of a compositor does not: its pixels belong to
// another process, it renders into shared textures, and a window of its own
// would be a second empty window on the desktop beside the one its output is
// actually shown in.
//
// What it needs is smaller than a window, not larger. A device is an instance,
// an adapter and a queue; a swapchain is the only part of the usual path that
// needs a surface, and a pass into a TEXTURE never touches one. So this is the
// ordinary device creation with the windowing left out, rather than a window
// with a flag that hides it -- there is nothing to hide.
//
//     var device = openHeadlessGraphics()
//     let surface = createSharedSurface(width: 1280, height: 800)
//     let target = importSharedTexture(device.graphics, surface)
//     ...
//     var frame = device.frame()
//     batch.presentBatchIntoTexture(frame, device.graphics, target.texture, ...)
//     device.submit()
//
// The frame is made and submitted by the caller because a component's pace is
// its own: a browser draws when a page moves and an assistant draws when a token
// arrives, and neither is a display refresh.
public struct EMGraphicsHeadless {
    // The headless device state is an ordinary typed owner. `EMGraphics` keeps
    // only borrowed raw callback words into it; this field is the lifetime.
    var context: NativeState<EMGraphicsAppRuntimeState>
    var graphics: EMGraphics = EMGraphics {
        userData: nullPointer(),
        backend: .Dawn,
        backendContext: nullPointer()
    }
    var ready: Bool = false

    // A frame to record passes into. Every pass must target a TEXTURE: there is
    // no swapchain here, and a pass that asked for one would be asking for the
    // window this deliberately does not have.
    function frame() -> RenderFrame {
        if self.ready && self.graphics.backend == .Vulkan {
            let context = nativeUserDataBorrow(self.context)
            let _ = vulkanPrepareHeadlessFrame(context)
        }
        return self.graphics.frame()
    }

    // Hand everything recorded since the last submit to the queue.
    function submit() {
        if self.ready == false {
            return
        }
        let context = nativeUserDataBorrow(self.context)
        if self.graphics.backend == .Vulkan {
            vulkanSubmitHeadlessFrame(context)
            return
        }
        var state = nativeRecover<EMGraphicsAppRuntimeState>(context)
        dawnSubmitEncoder(state)
        return
    }

    // Let the device make progress on work already submitted.
    //
    // A windowed program gets this for free from its run loop, which processes
    // events every time it presents. A component has no run loop, so it says so
    // itself -- and a component that never did would submit work the device
    // never got round to reporting on.
    function tick() {
        if self.ready == false {
            return
        }
        if self.graphics.backend == .Vulkan { return }
        let context = nativeUserDataBorrow(self.context)
        var state = nativeRecover<EMGraphicsAppRuntimeState>(context)
        wgpuInstanceProcessEvents(state.dawn.instance)
        return
    }

    // Read one headless render target back as a binary PPM.
    function capture(texture: borrow EMGraphicsTexture, path: borrow String) -> Bool {
        if self.ready == false {
            return false
        }
        let context = nativeUserDataBorrow(self.context)
        if self.graphics.backend == .Vulkan {
            return vulkanCaptureTexture(context, texture, path)
        }
        return dawnCaptureTexture(context, texture, path)
    }

    function close() {
        if self.ready == false {
            return
        }
        let context = nativeUserDataBorrow(self.context)
        var state = nativeRecover<EMGraphicsAppRuntimeState>(context)
        if self.graphics.backend == .Vulkan {
            vulkanShutdownState(state.vulkan)
        } else {
            dawnShutdown(state)
        }
        self.graphics.userData = nullPointer()
        self.graphics.backendContext = nullPointer()
        self.ready = false
        return
    }
}

// Shut a device down IN PLACE, without consuming it.
//
// `EMGraphicsHeadless.close` takes the device by value, so it cannot shut down a
// device that lives inside another struct's field — a partial move of a
// single-owner native value is not allowed. A component that keeps its device in
// a surface set needs to close it and keep the (now not-ready) handle, so this
// does the same teardown through a mutable borrow. After it returns the device
// answers `ready` false and can be reopened with `openHeadlessGraphics`.
public function closeHeadlessGraphics(device: borrow mut EMGraphicsHeadless) {
    if device.ready == false {
        return
    }
    let context = nativeUserDataBorrow(device.context)
    var state = nativeRecover<EMGraphicsAppRuntimeState>(context)
    if device.graphics.backend == .Vulkan {
        vulkanShutdownState(state.vulkan)
    } else {
        dawnShutdown(state)
    }
    device.graphics.userData = nullPointer()
    device.graphics.backendContext = nullPointer()
    device.ready = false
    return
}

// Open a device with no window.
//
// Answers `ready` false where there is no device to be had -- a machine with no
// GPU, a backend that has no headless path -- rather than trapping, because a
// component that cannot draw should say so to the shell that started it and
// exit, not take the desktop's compositor client down with an abort.
public function openHeadlessGraphics() -> EMGraphicsHeadless {
    return openHeadlessGraphicsWithBackend(.Dawn)
}

public function openHeadlessGraphicsWithBackend(backend: RenderBackendKind) -> EMGraphicsHeadless {
    let application = EMGraphicsApplication {
        title: "kira-headless",
        width: 1,
        height: 1,
        sampleCount: 1,
        windowMode: .Windowed,
        transparent: false,
        opacity: 1.0,
        backend: backend
    }
    var runtimeState = nativeState(EMGraphicsAppRuntimeState {
        app: application,
        userData: nullPointer(),
        frameIndex: 0
    })
    let context = nativeUserDataBorrow(runtimeState)
    var state = nativeRecover<EMGraphicsAppRuntimeState>(context)
    var created = false
    if backend == .Vulkan {
        created = vulkanCreateHeadlessDevice(state)
    } else if backend == .Dawn {
        created = dawnCreateDeviceAndQueue(state, context)
    }
    if !created {
        graphicsFail(.Device, "no headless device could be created")
        return EMGraphicsHeadless {
            context: move runtimeState,
            graphics: EMGraphics {
                userData: nullPointer(),
                backend: backend,
                backendContext: nullPointer()
            },
            ready: false
        }
    }
    return EMGraphicsHeadless {
        context: move runtimeState,
        graphics: EMGraphics {
            userData: context,
            backend: backend,
            backendContext: context
        },
        ready: true
    }
}
