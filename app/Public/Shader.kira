// A compiled shader, and the reflection its creation produced.
//
// `hasPositionAttribute` / `hasNormalAttribute` / `requiredUniformMask` /
// `availableUniformMask` / `uniformBlocks` used to live in the Sokol backend's
// own `kg_shader_records` table, keyed by id. They live here now, on the value
// every caller already threads through pipeline creation — so a pipeline built
// from this shader copies them rather than looking them up.
public struct GraphicsShader {
    var id: ShaderId = NoShaderId
    var hasPositionAttribute: Bool = false
    var hasNormalAttribute: Bool = false
    var requiredUniformMask: UN32 = 0
    var availableUniformMask: UN32 = 0
    var uniformBlocks: [UniformBlockDescriptor] = []
}

public function emptyGraphicsShader() -> GraphicsShader {
    return GraphicsShader { id: NoShaderId }
}
