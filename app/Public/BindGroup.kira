// A set of resources bound together at one or more encoder slots.
//
// The entries live behind `storage`, recovered through `nativeState` exactly
// as `RenderEncoder`'s and `UiBatch`'s own state is: a caller almost always
// holds a `BindGroup` through a `let` (`bindGroupOrReport` answers one), and
// `nativeRecover` mutates what `storage` points to regardless of whether the
// binding that read it was a `let` or a `var` — the same property that makes
// `RenderEncoder.setPipeline` work without demanding `var encoder`.
//
// `kg_bind_group_record` used to cap each entry kind at four and store them in
// fixed slots, because the C table had to reserve its shape up front. The
// state here reserves nothing — it grows exactly as far as the entries a
// caller adds — and a uniform entry holds a reference to the very
// `GraphicsUniform` its caller passed in (see `GraphicsUniform.kira`), not a copy of
// whatever it held when the entry was added.
public struct StoredUniformBindEntry {
    var uniformSlot: UN32 = 0
    var uniformId: UniformId = NoUniformId
    var storage: NativeState<UniformState>
}

public struct BindGroupState {
    var label: String = ""
    var uniformEntries: [StoredUniformBindEntry] = []
    var textureEntries: [TextureBindEntry] = []
    var samplerEntries: [SamplerBindEntry] = []
    var storageEntries: [StorageBindEntry] = []
    // How many times the entries above have changed.
    //
    // A backend that has to mint a device-side object from them — WebGPU's
    // `WGPUBindGroup` is immutable once created — caches that object and rebuilds
    // it when this moves. Sokol needs none: it applies the entries at the draw
    // and has nothing to invalidate.
    var revision: UNumber = 0
    // The Dawn backend's cached `WGPUBindGroup`, and what it was built for.
    //
    // A WebGPU bind group is created against a *pipeline's* layout for a
    // *particular* group index, and neither is known when a caller builds the
    // group — the group usually exists before any pipeline does. So the real
    // object is minted at the first draw that binds it and kept until the
    // pipeline, the slot, or the entries change. Ids rather than pointers,
    // because the id space is the backend's own table and a `RawPtr` field has
    // no zero a struct declaration can name.
    var deviceGroupId: UN32? = .None
    var devicePipeline: UN32 = 0
    // What the cached device object was built for, so a stale cache is a
    // rebuild rather than a bind against the wrong pipeline.
    //
    // Optional rather than -1: a group that has never been minted has no
    // pipeline and no slot, and `-1` would be a slot number nothing could
    // distinguish from a real one.
    var deviceSlot: UN32? = .None
    var deviceRevision: UNumber? = .None
    // What tells this group apart from every other one, for a cache keyed on
    // several groups at once.
    //
    // `BindGroup.id` cannot: every live group answers the same non-zero
    // sentinel, because nothing else keys on it. Assigned on first use by the
    // backend that needs it (Dawn merges an encoder's four slots into one
    // WebGPU group and caches the result against the combination), so a run on
    // a backend that does not need identities never spends one.
    var identity: UNumber? = .None
}

public class BindGroup {
    // Typed affine owner of the CPU-side group state. Nested uniform owners are
    // released recursively with this state, so no raw token carries a hidden
    // destruction obligation.
    var storage: NativeState<BindGroupState>
    var id: BindGroupId = NoBindGroupId
}

public function emptyBindGroup() -> BindGroup {
    return BindGroup { storage: nativeState(BindGroupState {}), id: NoBindGroupId }
}

// A slot that has never been bound. No state box at all, which is what an
// unset encoder slot is: every read of one is gated on its `has` flag, so
// there is nothing behind the token to read — and nothing to free, which is
// the point. `emptyBindGroup` stays for callers that may still add entries;
// this is for slots whose emptiness is final.
public function unboundBindGroup() -> BindGroup {
    return BindGroup { storage: nativeState(BindGroupState {}), id: NoBindGroupId }
}

// The slot is the shader's own `@group(0)` binding index, in the same space its
// textures are numbered in — so a shader that declares its uniform after eight
// textures is asking for the ninth binding, not a ninth block.
public function addUniformToBindGroup(
    group: borrow BindGroup,
    uniformSlot: UN32,
    uniform: borrow GraphicsUniform
) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if uniformSlot >= BindGroupLimits.maxViewBindSlots {
        log fault(
            "bind group uniform slot is outside the binding range a shader group numbers",
            label: state.label
        )
        return
    }
    state.uniformEntries.append(
        StoredUniformBindEntry {
            uniformSlot: uniformSlot,
            uniformId: uniform.id,
            storage: nativeUserData(uniform.storage)
        }
    )
}

public function addTextureToBindGroup(
    group: borrow BindGroup,
    textureSlot: UN32,
    texture: borrow GraphicsTexture
) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if texture.viewId == 0 {
        log fault("bind group cannot bind a texture with no sampled view", label: state.label)
        return
    }
    if textureSlot >= BindGroupLimits.maxViewBindSlots {
        log fault("bind group texture slot is outside the supported view range", label: state.label)
        return
    }
    state.textureEntries.append(TextureBindEntry { textureSlot: textureSlot, texture: texture })
}

public function addSamplerToBindGroup(
    group: borrow BindGroup,
    samplerSlot: UN32,
    sampler: borrow GraphicsSampler
) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if sampler.id == 0 {
        log fault("a bind group cannot bind a sampler the device never created", label: state.label)
        return
    }
    if samplerSlot >= BindGroupLimits.maxSamplerBindSlots {
        log fault(
            "bind group sampler slot is outside the supported sampler range",
            label: state.label
        )
        return
    }
    state.samplerEntries.append(SamplerBindEntry { samplerSlot: samplerSlot, sampler: sampler })
}

public function addStorageBufferToBindGroup(
    group: borrow BindGroup,
    storageSlot: UN32,
    bufferId: BufferId
) {
    var state = nativeRecover<BindGroupState>(group.storage)
    if !bufferId.isPresent() {
        log fault("bind group cannot bind a storage buffer with no view", label: state.label)
        return
    }
    if storageSlot >= BindGroupLimits.maxViewBindSlots {
        log fault("bind group storage slot is outside the supported view range", label: state.label)
        return
    }
    state.storageEntries.append(StorageBindEntry { storageSlot: storageSlot, bufferId: bufferId })
}

public namespace BindGroupLimits {
    let maxViewBindSlots: UN32 = 32
    let maxUniformBlockSlots: UN32 = 8
    let maxSamplerBindSlots: UN32 = 12
}

// A texture and the sampler that reads it, each at its own slot: the group a
// sampled draw binds most often.
public struct TextureSamplerBinding {
    var label: String = ""
    var textureSlot: UN32 = 0
    var texture: GraphicsTexture = GraphicsTexture()
    var samplerSlot: UN32 = 0
    var sampler: GraphicsSampler = GraphicsSampler()
}
