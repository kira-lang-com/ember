import Foundation
import Heap
// The public graphics surface: one method per thing a renderer asks for, and
// nothing else.
//
// Every method here forwards to `RenderBackend`, the construct family whose two
// declarations — `MetalRenderBackend` and `DawnRenderBackend` — do the work.
// This class used to hold 34 hand-written `match self.backend` blocks; the
// dispatch is `renderBackendFor` now, in one place, and adding a backend is a
// declaration rather than an edit at every method.
//
// The one method that names no backend is `createTextureFromFile`, because
// decoding an image is not a backend's work.
public class Graphics {
    var userData: RawPtr
    var backend: RenderBackendKind = .Dawn
    // The backend's own per-run context: Metal's context object, and Dawn's
    // `GraphicsRuntimeState` the run loop keeps its frame counters on. It
    // was called `metalContext` and it was null on every backend but Metal,
    // which is why callers started reading `!isNull(...)` as "am I
    // Metal" — a question about identity wearing the name of a resource.
    var backendContext: RawPtr

    // The selected backend as a value that answers, rather than as a tag to
    // switch on. Built per call: it is the backend enum and the context pointer
    // and nothing else, and no method below is on the per-draw path — a draw
    // goes through `RenderEncoder`, which carries its own.
    function renderBackend() -> Any RenderBackend {
        return renderBackendFor(self.backend, self.backendContext)
    }

    function createShader(descriptor: borrow ShaderDescriptor) -> ShaderResult {
        return self.renderBackend().createShader(descriptor)
    }

    // Compile a KSL asset `kira shader build` has written out. Each backend
    // reads the file its own device compiles.
    function createShaderFromKsl(descriptor: borrow KslShaderDescriptor) -> ShaderResult {
        return self.renderBackend().createShaderFromKsl(descriptor)
    }

    // Shader creation from an inline `ksl!` artifact — the whole artifact rather
    // than a list of its fields, because which target's text a backend reads is
    // the backend's business. Nothing is read from a file.
    function createShaderFromKslArtifact(
        label: borrow String,
        artifact: borrow KslArtifact
    ) -> ShaderResult {
        return self.renderBackend().createShaderFromKslArtifact(label, artifact)
    }

    function destroyShader(shader: GraphicsShader) {
        self.renderBackend().destroyShader(shader)
    }

    function createRenderPipeline(descriptor: borrow RenderPipelineDescriptor) -> PipelineResult {
        return self.renderBackend().createRenderPipeline(descriptor)
    }

    function destroyPipeline(pipeline: borrow RenderPipeline) {
        self.renderBackend().destroyPipeline(pipeline)
    }

    function destroyRenderPipeline(pipeline: borrow RenderPipeline) {
        destroyPipeline(pipeline)
    }

    // A persistent buffer of `floatCapacity` f32 slots that the CPU rewrites,
    // and the memory it writes into. The UI compositor allocates one per
    // emission stream and refills it every frame rather than churning buffers.
    //
    // The memory arrives with the buffer because the two are not always the same
    // storage: on Metal/Vulkan a write lands where the GPU reads, while a staging
    // backend writes into a block `commitDynamicBuffer` hands over. See `DynamicBuffer`.
    function createDynamicBuffer(
        label: borrow String,
        floatCapacity: Number
    ) -> DynamicBufferResult {
        return self.renderBackend().createDynamicBuffer(label, floatCapacity)
    }

    // Claim this frame's slot in a dynamic buffer and return the byte offset
    // every write into it this frame must add to its own. Call once per frame,
    // before writing: the frame the GPU is still drawing keeps the slot it was
    // recorded with, so nothing written past this offset can tear it.
    function dynamicBufferFrameStart(buffer: borrow GraphicsBuffer) -> Number {
        return self.renderBackend().dynamicBufferFrameStart(buffer)
    }

    // Hand the first `floatCount` slots written into `contents` to the GPU. A
    // call of its own rather than something every write does, because a backend
    // that stages may run it at most ONCE per buffer per frame.
    function commitDynamicBuffer(
        buffer: borrow GraphicsBuffer,
        contents: RawPtr,
        floatCount: UNumber
    ) {
        self.renderBackend().commitDynamicBuffer(buffer, contents, floatCount)
    }

    function createBuffer(descriptor: borrow BufferDescriptor) -> BufferResult {
        return self.renderBackend().createBuffer(descriptor)
    }

    function createIndexBuffer(descriptor: borrow IndexBufferDescriptor) -> BufferResult {
        return self.renderBackend().createIndexBuffer(descriptor)
    }

    function destroyBuffer(buffer: borrow GraphicsBuffer) {
        self.renderBackend().destroyBuffer(buffer)
    }

    function createUniform(descriptor: borrow UniformDescriptor) -> UniformResult {
        return self.renderBackend().createUniform(descriptor)
    }

    function updateUniform(uniform: borrow GraphicsUniform, data: borrow[Number]) {
        self.renderBackend().updateUniform(uniform, data)
    }

    function destroyUniform(uniform: borrow GraphicsUniform) {
        self.renderBackend().destroyUniform(uniform)
    }

    function createBindGroup(descriptor: borrow BindGroupDescriptor) -> BindGroupResult {
        return self.renderBackend().createBindGroup(descriptor)
    }

    function createUniformBindGroup(
        label: borrow String,
        uniformSlot: UN32,
        uniform: borrow GraphicsUniform
    ) -> BindGroupResult {
        return self.renderBackend().createUniformBindGroup(label, uniformSlot, uniform)
    }

    // Bind a buffer a shader reads as storage — the compositor's quad stream, or
    // any per-instance table a vertex stage indexes by vertex id.
    function createStorageBufferBindGroup(
        label: borrow String,
        slot: UN32,
        bufferId: BufferId
    ) -> BindGroupResult {
        return self.renderBackend().createStorageBufferBindGroup(label, slot, bufferId)
    }

    // An EMPTY bind group, filled by the two `bindGroupAdd*` calls below.
    //
    // The one-shot constructors around it each fix how many resources a group
    // holds, which the shader — not the constructor — decides: a KSL shader
    // numbers every resource in a group sequentially, so a group may carry two
    // texture/sampler pairs, or a buffer beside a texture, and no fixed shape
    // covers them all. A renderer with more resources than the encoder's four
    // group slots has nowhere to put them otherwise.
    function beginBindGroup(label: borrow String) -> BindGroupResult {
        return self.renderBackend().beginBindGroup(label)
    }

    // Add a texture at `slot`; the fragment stage reads it at [[texture(slot)]].
    function bindGroupAddTexture(
        group: borrow BindGroup,
        slot: UN32,
        texture: borrow GraphicsTexture
    ) {
        self.renderBackend().bindGroupAddTexture(group, slot, texture)
    }

    // Add a sampler at `slot`; the fragment stage reads it at [[sampler(slot)]].
    function bindGroupAddSampler(
        group: borrow BindGroup,
        slot: UN32,
        sampler: borrow GraphicsSampler
    ) {
        self.renderBackend().bindGroupAddSampler(group, slot, sampler)
    }

    // Add a uniform block at `slot`, so a group can carry the resources a shader
    // reads together rather than spending a second encoder slot on one number.
    function bindGroupAddUniform(
        group: borrow BindGroup,
        slot: UN32,
        uniform: borrow GraphicsUniform
    ) {
        self.renderBackend().bindGroupAddUniform(group, slot, uniform)
    }

    // Add a storage buffer to a group begun with `beginBindGroup`.
    function bindGroupAddStorageBuffer(
        group: borrow BindGroup,
        slot: UN32,
        buffer: borrow GraphicsBuffer
    ) {
        self.renderBackend().bindGroupAddStorageBuffer(group, slot, buffer)
    }

    function createTextureSamplerBindGroup(
        binding: borrow TextureSamplerBinding
    ) -> BindGroupResult {
        return self.renderBackend().createTextureSamplerBindGroup(binding)
    }

    // Destroying reclaims BOTH halves: the backend's id, and the state box
    // holding the entry arrays — the group's whole CPU-side existence. The
    // group is dead after this; recovering through the held value again is the
    // use-after-free the box's magic word traps.
    function destroyBindGroup(bindGroup: borrow BindGroup) {
        self.renderBackend().destroyBindGroup(bindGroup)
    }

    // The Retina backing scale (physical pixels per point) of the current
    // drawable.
    function backingScale() -> Number {
        return self.renderBackend().backingScale()
    }

    // Drawable size in framebuffer pixels. A host rendering context-sized
    // offscreen targets must use these rather than the Metal-only
    // backend context accessors, which remain valid on every backend.
    function contextWidth() -> Number {
        return self.renderBackend().contextWidth()
    }

    function contextHeight() -> Number {
        return self.renderBackend().contextHeight()
    }

    function createTexture(descriptor: borrow TextureDescriptor) -> TextureResult {
        return self.renderBackend().createTexture(descriptor)
    }

    // Create a texture that already has its pixels.
    //
    // `pixels` is RGBA8, row-major, four bytes per pixel and no header —
    // `width * height * 4` entries. One step rather than create-then-upload
    // because a backend can do better when the contents arrive with the image:
    // a backend may keep it immutable, and Metal re-tiles it once into the layout
    // every later sample reads.
    function createTextureFromPixels(
        descriptor: borrow TextureDescriptor,
        pixels: borrow[UN8]
    ) -> TextureResult {
        return self.renderBackend().createTextureFromPixels(descriptor, pixels)
    }

    // Replace a texture's pixels.
    //
    // Whole-image, which is the shape all current backends share: there is no
    // sub-region upload in this public contract. A caller changing part of an atlas composites
    // into its own array and hands the whole thing over, so no backend keeps a
    // CPU copy of a texture nobody asked it to remember.
    //
    // The texture must have been created with the `SampledStreaming` usage.
    function updateTexture(
        texture: borrow GraphicsTexture,
        width: UN32,
        height: UN32,
        pixels: borrow[UN8]
    ) {
        self.renderBackend().updateTexture(texture, width, height, pixels)
    }

    // Replace a texture's contents from raw memory the caller already owns.
    //
    // For a texture the caller composites into itself — a glyph atlas, whose CPU
    // side has to exist anyway so a new glyph can be packed beside the old ones.
    // Handing over the pointer avoids copying a megabyte-scale image into a Kira
    // array first, and one whole-image upload per changed frame is fewer uploads
    // than one per glyph, which is what the sub-region form cost.
    //
    // The texture must have been created with the `SampledStreaming` usage,
    // and a backend may impose a once-per-frame upload limit.
    function updateTextureBytes(texture: borrow GraphicsTexture, bytes: RawPtr, byteCount: Number) {
        self.renderBackend().updateTextureBytes(texture, bytes, byteCount)
    }

    // `updateTextureBytes` for an image of which only `rowCount` rows from
    // `firstRow` changed: a glyph atlas gains a few glyphs on a shelf or two,
    // and sending the whole image again for them costs more than the frame.
    function updateTextureRows(
        texture: borrow GraphicsTexture,
        bytes: RawPtr,
        firstRow: UN32,
        rowCount: UN32
    ) {
        self.renderBackend().updateTextureRows(texture, bytes, firstRow, rowCount)
    }

    function destroyTexture(texture: borrow GraphicsTexture) {
        self.renderBackend().destroyTexture(texture)
    }

    // A render target whose memory another process can import: a dma-buf on a
    // Vulkan device under Linux, an IOSurface on Metal. Dawn answers
    // `.Unexportable`. See `ExportedTexture.kira`.
    function createExportedTexture(
        descriptor: borrow ExportedTextureDescriptor
    ) -> ExportedTextureResult {
        return self.renderBackend().createExportedTexture(descriptor)
    }

    // Destroy an exported texture and close its handle. What a peer imported
    // stays valid on its side; this side's reference is what goes.
    function destroyExportedTexture(exported: borrow ExportedTexture) {
        self.renderBackend().destroyExportedTexture(exported)
    }

    // A sampled texture over memory another process exported: a dma-buf on a
    // Vulkan device under Linux. Dawn and Metal answer `.Unimportable`. The
    // handle is the texture's once this succeeds and the caller's when it
    // fails; `destroyTexture` lets the texture and its memory go.
    function importTexture(memory: borrow ExportedMemory) -> ImportedTextureResult {
        return self.renderBackend().importTexture(memory)
    }

    // Decode an image file (PNG, JPEG) into a sampled texture.
    //
    // The one method here that names no backend, because decoding is not a
    // backend's work. `decodeImageFile` is Foundation's, reaches no device, and
    // hands back the same RGBA8 that `createTextureFromPixels` already takes on
    // all backends. This used to be a member one backend answered and Metal
    // declined, which made "can this program load a PNG" a question about which
    // GPU was in the machine.
    //
    // The pixels arrive with their first row at the top, which is where every
    // one of these formats puts it and what `createTextureFromPixels` means by
    // row zero. A renderer whose texture coordinates run the other way flips
    // them in its own shader.
    function createTextureFromFile(label: borrow String, path: borrow String) -> TextureResult {
        match decodeImageFile(path) {
            Ok(image) -> {
                return self.createTextureFromPixels(
                    TextureDescriptor {
                        label: label,
                        width: UN32(image.width),
                        height: UN32(image.height),
                        format: .Rgba8Unorm,
                        usage: .Sampled,
                        sampleCount: 1,
                        storage: .Persistent
                    },
                    widenBytes(image.pixels)
                )
            }
            // A path with nothing at it, bytes that are not an image, and an
            // image whose bytes are damaged are one answer to a caller loading
            // an asset: it could not be read.
            Error(reason) -> { return .Error(.AssetUnreadable) }
        }
    }

    function createSampler(descriptor: borrow SamplerDescriptor) -> SamplerResult {
        return self.renderBackend().createSampler(descriptor)
    }

    function destroySampler(sampler: borrow GraphicsSampler) {
        self.renderBackend().destroySampler(sampler)
    }

    function frame() -> RenderFrame {
        return RenderFrame {
            attachments: PassAttachments {
                color: ColorAttachment {
                    target: swapchainRenderTarget(),
                    clearColor: RGBAColor {},
                    resolveTarget: emptyRenderTarget()
                },
                depth: emptyDepthAttachment(),
                stencil: emptyStencilAttachment()
            },
            hasRenderPass: false,
            renderPassActive: false,
            passSubmitted: false,
            shouldQuit: false,
            userData: self.userData,
            backend: self.backend,
            backendContext: self.backendContext
        }
    }
}
