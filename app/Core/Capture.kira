import Foundation
import Heap

// Reading rendered pixels back into a file.
//
// A pass that began and a draw that was counted are equally true of a frame
// that came out blank; a capture is what shows what a frame contains. Every
// backend copies its image into a host-visible buffer and hands the mapped
// bytes here, which writes them as a binary PPM (`P6`).

// Why a frame or texture could not be captured.
public enum CaptureFailure {
    NoDevice
    // The backend has no readback for this kind of target.
    Unsupported
    NoTexture
    // The frame the copy is recorded into could not be begun.
    FrameNotBegun
    // The swapchain's images cannot be copied out, or are a format the
    // capture does not write.
    NotReadable
    NoImage
    StagingRefused
    SubmissionFailed
    MapFailed
    File(FileFailure)
}

// The order of the four 8-bit channels in a captured pixel.
public enum PixelOrder {
    Rgba
    Bgra
}

// One captured pixel as it sits in mapped memory.
public @FFI.Struct { layout: c }
struct MappedPixel {
    var first: U8
    var second: U8
    var third: U8
    var alpha: U8
}

// Rows of pixels a backend mapped, `bytesPerRow` apart: a copy may pad each row
// past `width` pixels.
public struct MappedPixels {
    let start: RawPtr
    let width: UNumber
    let height: UNumber
    let bytesPerRow: UNumber
    let order: PixelOrder
}

namespace PortablePixmap {
    let magic: String = "P6"
    let sampleMaximum: UNumber = 255
}

// The mapped pixels as a binary PPM: red, green and blue per pixel, no alpha
// and no row padding.
public function portablePixmap(pixels: borrow MappedPixels) -> [UN8] {
    let header = "\(PortablePixmap.magic)\n\(pixels.width) \(pixels.height)\n\(PortablePixmap.sampleMaximum)\n"
    var bytes = header.utf8()
    for row in 0..pixels.height {
        for column in 0..pixels.width {
            let pixel = heapLoad<MappedPixel>(
                pixels.start,
                row * pixels.bytesPerRow + column * sizeOf<MappedPixel>()
            )
            match pixels.order {
                Rgba -> {
                    bytes.append(UN8(pixel.first))
                    bytes.append(UN8(pixel.second))
                    bytes.append(UN8(pixel.third))
                }
                Bgra -> {
                    bytes.append(UN8(pixel.third))
                    bytes.append(UN8(pixel.second))
                    bytes.append(UN8(pixel.first))
                }
            }
        }
    }
    return bytes
}

// The mapped pixels as red, green, blue and alpha bytes, with no row padding.
public function mappedRgba(pixels: borrow MappedPixels) -> [UN8] {
    return mappedRgbaEvery(pixels, 1)
}

// Every `every`-th pixel of each mapped row, from the first, as red, green,
// blue and alpha bytes, row after row.
public function mappedRgbaEvery(pixels: borrow MappedPixels, every: UNumber) -> [UN8] {
    var bytes: [UN8] = []
    let swapped = pixels.order == .Bgra
    let step = max(every, 1) * sizeOf<MappedPixel>()
    for row in 0..pixels.height {
        var at = row * pixels.bytesPerRow
        let end = at + pixels.width * sizeOf<MappedPixel>()
        while at < end {
            let pixel = heapLoad<MappedPixel>(pixels.start, at)
            bytes.append(swapped ? pixel.third : pixel.first)
            bytes.append(UN8(pixel.second))
            bytes.append(swapped ? pixel.first : pixel.third)
            bytes.append(UN8(pixel.alpha))
            at += step
        }
    }
    return bytes
}

// Each mapped row's texels as they are, `texelBytes` a pixel, without the
// row padding: a half-float texture's channels as little-endian halves.
public function mappedTexels(pixels: borrow MappedPixels, texelBytes: UNumber) -> [UN8] {
    var bytes: [UN8] = []
    for row in 0..pixels.height {
        let view = Heap.MemoryView {
            start: heapOffset(pixels.start, row * pixels.bytesPerRow),
            count: pixels.width * texelBytes
        }
        for byte in viewBytes(view) {
            bytes.append(byte)
        }
    }
    return bytes
}

// The mapped pixels written to `path`.
public function writeCapture(
    pixels: borrow MappedPixels,
    path: borrow String
) -> Result<Void, CaptureFailure> {
    return match writeFileBytes(path, portablePixmap(pixels)) {
        Ok -> .Ok
        Error(failure) -> .Error(.File(failure))
    }
}
