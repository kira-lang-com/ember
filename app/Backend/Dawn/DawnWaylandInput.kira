import Foundation
import Heap
// Pointer input, on Wayland.
//
// A window is not an input device here. The surface the compositor shows and the
// seat it sends events from are separate objects, and a client that binds only
// `wl_compositor` and `xdg_wm_base` has asked to be SEEN, not to be touched --
// which is why this window drew perfectly and answered nothing until the seat
// below was bound.
//
// A seat announces what it has rather than being asked, so a pointer cannot be
// taken at bind time: `wl_seat.capabilities` arrives, and the handler for it is
// where a `wl_pointer` first exists.
//
// Every handler is a plain C function pointer, which cannot close over anything.
// What they need is the run state, so the run state's own pointer is what is
// handed to the listener as its `data` -- the same word the Win32 side hangs on
// the window. Each handler recovers it INLINE: a recovered value returned
// through a helper is a copy, and a pointer position written to a copy is a
// pointer position thrown away.

// A pointer arriving over the surface. Its position, in surface-local
// coordinates, is carried as `wl_fixed_t` here and on motion -- and nowhere
// else, a button press having none -- so the last one seen is where a press is.
public function waylandOnPointerEnter(
    data: RawPtr,
    pointer: RawPtr,
    serial: U32,
    surface: RawPtr,
    sx: I32,
    sy: I32
) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    state.dawn.pointerResizeEdge = U32(0)
    state.dawn.pointerSurfaceOffsetX = 0
    state.dawn.pointerSurfaceOffsetY = 0
    let x = waylandFixedToNumber(sx)
    let y = waylandFixedToNumber(sy)
    state.dawn.input.pointerX = x
    state.dawn.input.pointerY = y
    state.dawn.input.hasPointer = true
    state.dawn.pointerEnterSerial = serial
    // The cursor over this surface is this client's to draw, and an enter is
    // the only event carrying the serial that authorises setting it. A client
    // that skips this is a window the pointer vanishes inside.
    if !isNull(state.dawn.cursorShapeDevice) {
        kira_wayland_cursor_shape_device_set_shape(
            state.dawn.cursorShapeDevice,
            serial,
            state.dawn.pointerResizeEdge == U32(
                0
            ) ? kira_wayland_cursor_shape_default() : kira_wayland_cursor_shape_for_resize_edge(
                state.dawn.pointerResizeEdge
            ),
        )
    }
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    onEvent(AppEvent { kind: .PointerEntered, pointerX: x, pointerY: y })
}

public function waylandOnPointerLeave(data: RawPtr, pointer: RawPtr, serial: U32, surface: RawPtr) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    state.dawn.input.hasPointer = false
    state.dawn.pointerResizeEdge = U32(0)
    state.dawn.pointerSurfaceOffsetX = 0
    state.dawn.pointerSurfaceOffsetY = 0
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    onEvent(
        AppEvent {
            kind: .PointerExited,
            pointerX: state.dawn.input.pointerX,
            pointerY: state.dawn.input.pointerY
        }
    )
}

public function waylandOnPointerMotion(data: RawPtr, pointer: RawPtr, time: U32, sx: I32, sy: I32) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    let x = waylandFixedToNumber(sx)
    let y = waylandFixedToNumber(sy)
    var deltaX: Number = 0
    var deltaY: Number = 0
    if state.dawn.input.hasPointer {
        deltaX = x - state.dawn.input.pointerX
        deltaY = y - state.dawn.input.pointerY
    }
    state.dawn.input.pointerX = x
    state.dawn.input.pointerY = y
    state.dawn.input.hasPointer = true
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    onEvent(
        AppEvent {
            kind: .PointerMoved,
            pointerX: x,
            pointerY: y,
            pointerDeltaX: deltaX,
            pointerDeltaY: deltaY
        }
    )
}

// A Linux input event code, not a button index: left is 0x110 and the others
// follow it.
public function waylandPointerButtonOf(code: U32) -> PointerButton {
    if code == DawnWaylandProtocol.buttonLeft {
        return .Left
    }
    if code == DawnWaylandProtocol.buttonRight {
        return .Right
    }
    if code == DawnWaylandProtocol.buttonMiddle {
        return .Middle
    }
    return .Other
}

public function waylandResizeEdge(state: borrow GraphicsRuntimeState, x: Number, y: Number) -> U32 {
    if state.dawn.pointerResizeEdge != U32(0) {
        return state.dawn.pointerResizeEdge
    }
    // Keep a slim inside fallback for compositors missing one of the optional
    // protocols used by the transparent outside frame.
    let grip = 4
    // The pointer is in points, and the surface's size in pixels.
    let scale = waylandSurfaceScale(state)
    let width = Number(state.dawn.surfaceWidth) / scale
    let height = Number(state.dawn.surfaceHeight) / scale
    let left = x >= 0 && x < grip
    let right = x <= width && x >= width - grip
    let top = y >= 0 && y < grip
    let bottom = y <= height && y >= height - grip
    if top && left { return kira_wayland_resize_edge_top_left() }
    if top && right { return kira_wayland_resize_edge_top_right() }
    if bottom && left { return kira_wayland_resize_edge_bottom_left() }
    if bottom && right { return kira_wayland_resize_edge_bottom_right() }
    if top { return kira_wayland_resize_edge_top() }
    if bottom { return kira_wayland_resize_edge_bottom() }
    if left { return kira_wayland_resize_edge_left() }
    if right { return kira_wayland_resize_edge_right() }
    return U32(0)
}

public function waylandOnPointerButton(
    data: RawPtr,
    pointer: RawPtr,
    serial: U32,
    time: U32,
    button: U32,
    buttonState: U32
) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    if button == DawnWaylandProtocol.buttonLeft && buttonState == DawnWaylandProtocol.buttonPressed &&
        !isNull(state.dawn.seat) && !isNull(state.dawn.toplevel) {
        let edge = waylandResizeEdge(state, state.dawn.input.pointerX, state.dawn.input.pointerY)
        if edge != U32(0) {
            kira_wayland_toplevel_resize(state.dawn.toplevel, state.dawn.seat, serial, edge)
            return
        }
        let dragRegion: (Number, Number) -> Bool = state.app.windowDragRegion
        if dragRegion(state.dawn.input.pointerX, state.dawn.input.pointerY) {
            kira_wayland_toplevel_move(state.dawn.toplevel, state.dawn.seat, serial)
            return
        }
    }
    var kind: AppEventKind = .PointerUp
    if buttonState == DawnWaylandProtocol.buttonPressed {
        kind = .PointerDown
    }
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    onEvent(
        AppEvent {
            kind: kind,
            pointerButton: waylandPointerButtonOf(button),
            pointerX: state.dawn.input.pointerX,
            pointerY: state.dawn.input.pointerY
        }
    )
}

function waylandToplevelStateSet(states: RawPtr, toplevelState: U32) -> Bool {
    return kira_wayland_toplevel_states_contains(states, toplevelState) != I32(0)
}

// Records the compositor's focus, and tells the application when it changed.
function waylandNoteFocus(
    state: borrow mut GraphicsRuntimeState,
    focused: Bool,
    onEvent: borrow (borrow AppEvent) -> Void
) {
    if state.app.backend == .Vulkan {
        state.vulkan.input.focused = focused
    }
    if focused == state.dawn.input.focused {
        return
    }
    state.dawn.input.focused = focused
    if focused {
        onEvent(AppEvent { kind: .Focused })
    } else {
        onEvent(AppEvent { kind: .Unfocused })
    }
}

// The pixels the surface draws for each of its points: the scale the run set
// on a Vulkan surface, and 1 on any other.
function waylandSurfaceScale(state: borrow GraphicsRuntimeState) -> Number {
    if state.app.backend == .Vulkan {
        return Int(kira_wayland_surface_scale(state.vulkan.window))
    }
    return 1
}

// Resizes the surface to the configured size, in points. Whether the size
// changed: a zero extent leaves the choice to the client, and keeps the
// current size.
function waylandApplyConfiguredSize(
    state: borrow mut GraphicsRuntimeState,
    width: Number,
    height: Number
) -> Bool {
    if width <= 0 || height <= 0 {
        return false
    }
    let scale = waylandSurfaceScale(state)
    if width * scale == state.dawn.surfaceWidth && height * scale == state.dawn.surfaceHeight {
        return false
    }
    if state.app.backend == .Vulkan {
        kira_wayland_surface_note_size(state.vulkan.window, I32(width), I32(height))
        state.dawn.surfaceWidth = width * scale
        state.dawn.surfaceHeight = height * scale
    } else {
        dawnConfigureSurface(state, width, height)
    }
    return true
}

public function waylandOnToplevelConfigure(
    data: RawPtr,
    toplevel: RawPtr,
    width: I32,
    height: I32,
    states: RawPtr
) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    state.dawn.maximized = waylandToplevelStateSet(states, kira_wayland_toplevel_state_maximized())
    let focused = waylandToplevelStateSet(states, kira_wayland_toplevel_state_activated())
    waylandNoteFocus(state, focused, onEvent)
    if !waylandApplyConfiguredSize(state, Number(width), Number(height)) {
        return
    }
    let scale = waylandSurfaceScale(state)
    onEvent(
        AppEvent {
            kind: .Resized,
            windowWidth: Number(width),
            windowHeight: Number(height),
            framebufferWidth: UN32(Number(width) * scale),
            framebufferHeight: UN32(Number(height) * scale)
        }
    )
}

// Client-side titlebar actions. xdg-shell keeps the policy in the compositor:
// these are requests, and configure events above are the authoritative state.
public function dawnWaylandMinimize(state: borrow GraphicsRuntimeState) {
    if !isNull(state.dawn.toplevel) {
        kira_wayland_toplevel_set_minimized(state.dawn.toplevel)
    }
}

public function dawnWaylandToggleMaximize(state: borrow GraphicsRuntimeState) {
    if isNull(state.dawn.toplevel) {
        return
    }
    if state.dawn.maximized {
        kira_wayland_toplevel_unset_maximized(state.dawn.toplevel)
        return
    }
    kira_wayland_toplevel_set_maximized(state.dawn.toplevel)
}

public function waylandOnToplevelClose(data: RawPtr, toplevel: RawPtr) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    state.dawn.quitRequested = true
    if state.app.backend == .Vulkan {
        state.vulkan.quitRequested = true
    }
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    onEvent(AppEvent { kind: .QuitRequested })
}

public function waylandOnToplevelConfigureBounds(
    data: RawPtr,
    toplevel: RawPtr,
    width: I32,
    height: I32
) { return }
public function waylandOnToplevelWmCapabilities(
    data: RawPtr,
    toplevel: RawPtr,
    capabilities: RawPtr
) { return }

// A wheel turn, as a distance rather than a count of notches: Wayland reports
// how far the surface should scroll, and one detent is conventionally ten
// surface units. The sign is the other way round from Win32 -- positive is
// downward here and away from the person there -- and everything above this
// seam is written against the Win32 convention.
public function waylandOnPointerAxis(
    data: RawPtr,
    pointer: RawPtr,
    time: U32,
    axis: U32,
    value: I32
) {
    var state = nativeRecover<GraphicsRuntimeState>(data)
    let notches = 0 - waylandFixedToNumber(value) / WaylandFixed.detent
    let onEvent: (borrow AppEvent) -> Void = state.app.eventHandler
    if axis == DawnWaylandProtocol.axisVertical {
        onEvent(
            AppEvent {
                kind: .Scroll,
                pointerX: state.dawn.input.pointerX,
                pointerY: state.dawn.input.pointerY,
                scrollY: notches
            }
        )
        return
    }
    onEvent(
        AppEvent {
            kind: .Scroll,
            pointerX: state.dawn.input.pointerX,
            pointerY: state.dawn.input.pointerY,
            scrollX: notches
        }
    )
}

// The four events a version-5 pointer sends that this client has no use for.
// They are handled rather than left out because a listener is indexed by the
// event's opcode: a struct with fewer members than the interface has events is
// read past the first time one of the missing ones arrives.
public function waylandOnPointerFrame(data: RawPtr, pointer: RawPtr) {}

public function waylandOnPointerAxisSource(data: RawPtr, pointer: RawPtr, source: U32) {}

public function waylandOnPointerAxisStop(data: RawPtr, pointer: RawPtr, time: U32, axis: U32) {}

public function waylandOnPointerAxisDiscrete(
    data: RawPtr,
    pointer: RawPtr,
    axis: U32,
    discrete: I32
) {}

// What the seat has. A pointer appears here and not before: the capability is
// an event, and asking a seat with no mouse behind it for a `wl_pointer` is a
// protocol error the compositor disconnects for.
public function waylandOnSeatCapabilities(data: RawPtr, seat: RawPtr, capabilities: U32) {
    if !seatHas(WaylandSeatCapability(capabilities), SeatCapability.pointer) {
        return
    }
    var state = nativeRecover<GraphicsRuntimeState>(data)
    if !isNull(state.dawn.pointer) {
        return
    }
    let pointer = kira_wayland_seat_get_pointer(seat)
    if isNull(pointer) {
        return
    }
    state.dawn.pointer = pointer
    let cursorShapeManager = kira_wayland_display_bind_cursor_shape_manager(
        kira_wayland_proxy_get_display(seat),
    )
    if !isNull(cursorShapeManager) {
        state.dawn.cursorShapeManager = cursorShapeManager
        state.dawn.cursorShapeDevice =
            kira_wayland_cursor_shape_manager_get_pointer(cursorShapeManager, pointer)
    }
    var listener = kira_wayland_pointer_listener {
        enter: waylandOnPointerEnter,
        leave: waylandOnPointerLeave,
        motion: waylandOnPointerMotion,
        button: waylandOnPointerButton,
        axis: waylandOnPointerAxis,
        frame: waylandOnPointerFrame,
        axis_source: waylandOnPointerAxisSource,
        axis_stop: waylandOnPointerAxisStop,
        axis_discrete: waylandOnPointerAxisDiscrete
    }
    if kira_wayland_pointer_add_listener(pointer, move listener, data) != I32(0) {
        log fault("the Wayland pointer already has a listener")
    }
}

public function waylandOnSeatName(data: RawPtr, seat: RawPtr, name: RawPtr) {}

// The seat, out of a registry of its own -- for the same reason the compositor
// and the shell each have one: a handler reports what it bound by setting the
// registry's single user-data word, and one word holds one global.
public function waylandOnSeatGlobal(
    data: RawPtr,
    registry: RawPtr,
    name: U32,
    interface: RawPtr,
    version: U32
) {
    if !waylandNamed(interface, "wl_seat") {
        return
    }
    // Version 5 is what this client speaks: a compositor offering less is asked
    // for what it has, and one offering more is not asked for events there is
    // no handler for.
    var bindVersion = version
    if bindVersion > U32(5) {
        bindVersion = U32(5)
    }
    let seat = kira_wayland_registry_bind_seat(registry, name, bindVersion)
    if isNull(seat) {
        return
    }
    kira_wayland_proxy_set_user_data(registry, seat)
    var state = nativeRecover<GraphicsRuntimeState>(data)
    state.dawn.seat = seat
    var listener = kira_wayland_seat_listener {
        capabilities: waylandOnSeatCapabilities,
        name: waylandOnSeatName
    }
    if kira_wayland_seat_add_listener(seat, move listener, data) != I32(0) {
        log fault("the Wayland seat already has a listener")
    }
}

// Why the window's toplevel could not be listened to.
enum WaylandToplevelFailure {
    NoToplevelRole
    ListenerTaken
    ConfigureFailed
}

// Listens to the window's xdg toplevel and takes its first configure. The
// initial empty commit requests that configure: the role listener goes in first
// so the compositor-selected size is not lost.
function waylandListenToplevel(
    state: borrow mut GraphicsRuntimeState,
    display: RawPtr,
    runtimeUserData: RawPtr
) -> Result<Void, WaylandToplevelFailure> {
    let toplevel = kira_wayland_proxy_get_user_data(state.dawn.window)
    if isNull(toplevel) {
        return .Error(.NoToplevelRole)
    }
    state.dawn.toplevel = toplevel
    var listener = kira_wayland_toplevel_listener {
        configure: waylandOnToplevelConfigure,
        close: waylandOnToplevelClose,
        configure_bounds: waylandOnToplevelConfigureBounds,
        wm_capabilities: waylandOnToplevelWmCapabilities
    }
    if kira_wayland_toplevel_add_listener(toplevel, move listener, runtimeUserData) != I32(0) {
        return .Error(.ListenerTaken)
    }
    kira_wayland_surface_commit(state.dawn.window)
    if kira_wayland_display_roundtrip(display) < I32(0) {
        return .Error(.ConfigureFailed)
    }
    return .Ok
}

// Binds the seat, and through its capabilities the pointer.
//
// Two round trips, not one: the first delivers the registry's globals and
// binds the seat, the second delivers the seat's own `capabilities` event --
// which is what the pointer is taken in. One round trip returns with a seat
// bound and no pointer on it.
function waylandBindSeat(display: RawPtr, runtimeUserData: RawPtr) {
    let registry = kira_wayland_display_get_registry(display)
    if isNull(registry) {
        log fault("the Wayland display refused a registry for the seat")
        return
    }
    var listener = kira_wayland_registry_listener {
        global: waylandOnSeatGlobal,
        global_remove: waylandOnGlobalRemove
    }
    if kira_wayland_registry_add_listener(registry, move listener, runtimeUserData) != I32(0) {
        log fault("the seat's Wayland registry already has a listener")
        return
    }
    if kira_wayland_display_roundtrip(display) < I32(0)
        || kira_wayland_display_roundtrip(display) < I32(0) {
        log fault("the Wayland display failed while binding the seat")
    }
}

// Binds the seat this run's window will be touched through.
//
// Called once, after the window exists and the run state is in hand -- the run
// state being what the handlers are given, and what `open` has no way to pass
// them.
public function dawnWaylandAttachInput(
    state: borrow mut GraphicsRuntimeState,
    runtimeUserData: RawPtr
) {
    if isNull(state.dawn.window) {
        return
    }
    let display = kira_wayland_proxy_get_display(state.dawn.window)
    if isNull(display) {
        return
    }
    match waylandListenToplevel(state, display, runtimeUserData) {
        Ok -> {}
        Error(failure) -> {
            log fault("could not listen to the Wayland toplevel", failure)
            return
        }
    }
    waylandBindSeat(display, runtimeUserData)
    if isNull(state.dawn.pointer) {
        log warn("this Wayland seat offers no pointer, so the window answers no mouse")
    }
}
