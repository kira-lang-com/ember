import Foundation
import Heap
// Reading a presented frame back into a file.
//
// This is the instrument every claim about what a frame CONTAINS rests on.
// Everything else a run can report — a pass that began, a draw that was counted,
// a first-frame marker — is equally true of a frame that came out blank, and a
// backend brought up without a way to look at its own output is a backend nobody
// can tell from a clear screen.
//
// The path is WebGPU's only one: copy the texture into a buffer, map the buffer,
// read the bytes. `CopySrc` is in the surface's configured usage for exactly
// this. The copy's rows are padded to the 256-byte multiple WebGPU requires of
// `bytesPerRow`, so the reader walks rows rather than one flat run.

public namespace DawnCapture {
    let copyRowAlignment: UNumber = 256
    let bytesPerPixel: UNumber = 4
    // How many times the device is ticked waiting for the readback's map to
    // answer before the capture gives up on it.
    let mapPolls: UNumber = 1000000
}

// The order a mapped 8-bit texture of `format` holds its channels in. A BGRA8
// swapchain, which is what every Windows swapchain is, stores blue first.
function dawnPixelOrder(format: I32) -> PixelOrder {
    if format == DawnVocabulary.formatBgra8Unorm {
        return .Bgra
    }
    return .Rgba
}

// The presented frame as a binary PPM at `path`, taken before the present so the
// texture is still this frame's.
public function dawnCaptureFrame(
    context: RawPtr,
    path: borrow String
) -> Result<Void, CaptureFailure> {
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let width = state.dawn.surfaceWidth
    let height = state.dawn.surfaceHeight
    if width <= 0 || height <= 0 || isNull(state.dawn.frameTexture) {
        return .Error(.NoImage)
    }
    return dawnCaptureTextureHandle(
        context,
        DawnCaptureSource {
            texture: state.dawn.frameTexture,
            width: width,
            height: height,
            format: state.dawn.surfaceFormat
        },
        path
    )
}

// An explicit texture as a binary PPM. Headless renderers have no swapchain, so
// this is the same readback instrument pointed at the texture they own.
public function dawnCaptureTexture(
    context: RawPtr,
    texture: borrow GraphicsTexture,
    path: borrow String
) -> Result<Void, CaptureFailure> {
    if !dawnHasDevice(context) {
        return .Error(.NoDevice)
    }
    if texture.id == 0 || texture.width <= 0 || texture.height <= 0 {
        return .Error(.NoTexture)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let handle = dawnObject(state, texture.id.raw)
    if isNull(handle) {
        return .Error(.NoTexture)
    }
    return dawnCaptureTextureHandle(
        context,
        DawnCaptureSource {
            texture: handle,
            width: texture.width,
            height: texture.height,
            format: dawnObjectFormat(state, texture.id.raw)
        },
        path
    )
}

// A texture a capture reads, and what it needs to know to read it.
struct DawnCaptureSource {
    let texture: RawPtr
    let width: UNumber
    let height: UNumber
    let format: I32
}

// The copy's rows, padded to the 256-byte multiple WebGPU requires of
// `bytesPerRow`.
function dawnCaptureRowBytes(width: UNumber) -> UNumber {
    return alignedUp(width * DawnCapture.bytesPerPixel, DawnCapture.copyRowAlignment)
}

function dawnCopyTextureToReadback(
    state: borrow GraphicsRuntimeState,
    source: borrow DawnCaptureSource,
    readback: RawPtr,
    bytesPerRow: UNumber
) {
    let encoder = wgpuDeviceCreateCommandEncoder(
        state.dawn.device,
        WGPUCommandEncoderDescriptor { label: dawnText("kira-frame-capture-encoder") }
    )
    wgpuCommandEncoderCopyTextureToBuffer(
        encoder,
        WGPUTexelCopyTextureInfo {
            texture: source.texture,
            mipLevel: U32(0),
            aspect: DawnVocabulary.textureAspectAll
        },
        WGPUTexelCopyBufferInfo {
            layout: WGPUTexelCopyBufferLayout {
                offset: U64(0),
                bytesPerRow: U32(bytesPerRow),
                rowsPerImage: U32(source.height)
            },
            buffer: readback
        },
        WGPUExtent3D {
            width: U32(source.width),
            height: U32(source.height),
            depthOrArrayLayers: U32(1)
        },
    )
    let commands = wgpuCommandEncoderFinish(encoder, WGPUCommandBufferDescriptor {})
    let submission: [RawPtr] = [commands]
    wgpuQueueSubmit(state.dawn.queue, U64(1), submission)
    wgpuCommandBufferRelease(commands)
    wgpuCommandEncoderRelease(encoder)
}

// The readback mapped for reading, ticking the device until the map answers.
function dawnMapReadback(
    context: RawPtr,
    state: borrow mut GraphicsRuntimeState,
    readback: RawPtr,
    byteCount: UNumber
) -> Result<Void, CaptureFailure> {
    state.dawn.mapResolved = false
    state.dawn.mapSucceeded = false
    wgpuBufferMapAsync(
        readback,
        DawnVocabulary.mapModeRead,
        U64(0),
        U64(byteCount),
        WGPUBufferMapCallbackInfo {
            mode: DawnVocabulary.callbackOnProcessEvents,
            callback: dawnBufferMapped,
            userdata1: context
        }
    )
    for _ in 0..DawnCapture.mapPolls {
        if state.dawn.mapResolved { break }
        wgpuDeviceTick(state.dawn.device)
        wgpuInstanceProcessEvents(state.dawn.instance)
    }
    if !state.dawn.mapSucceeded {
        return .Error(.MapFailed)
    }
    return .Ok
}

function dawnReleaseReadback(readback: RawPtr) {
    wgpuBufferDestroy(readback)
    wgpuBufferRelease(readback)
}

// `source` copied into a buffer, mapped, and written to `path`. The copy's rows
// are padded, so the writer walks rows rather than one flat run.
function dawnCaptureTextureHandle(
    context: RawPtr,
    source: borrow DawnCaptureSource,
    path: borrow String
) -> Result<Void, CaptureFailure> {
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let bytesPerRow = dawnCaptureRowBytes(source.width)
    let byteCount = bytesPerRow * source.height
    let readback = wgpuDeviceCreateBuffer(
        state.dawn.device,
        WGPUBufferDescriptor {
            label: dawnText("kira-frame-capture"),
            usage: DawnVocabulary.bufferUsageMapRead | DawnVocabulary.bufferUsageCopyDestination,
            size: U64(byteCount)
        }
    )
    if isNull(readback) {
        return .Error(.StagingRefused)
    }
    dawnCopyTextureToReadback(state, source, readback, bytesPerRow)
    match dawnMapReadback(context, state, readback, byteCount) {
        Ok -> {}
        Error(failure) -> {
            dawnReleaseReadback(readback)
            return .Error(failure)
        }
    }
    let pixels = MappedPixels {
        start: wgpuBufferGetConstMappedRange(readback, U64(0), U64(byteCount)),
        width: source.width,
        height: source.height,
        bytesPerRow: bytesPerRow,
        order: dawnPixelOrder(source.format)
    }
    let written = writeCapture(pixels, path)
    wgpuBufferUnmap(readback)
    dawnReleaseReadback(readback)
    return written
}
