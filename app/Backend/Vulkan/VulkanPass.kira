import Foundation
import Heap

// Dynamic rendering keeps a pipeline independent of a particular offscreen
// framebuffer. Each pass still owns explicit image-layout transitions, which is
// the Vulkan rule that makes pass ordering visible to the driver.

public function vulkanWindowScale(context: RawPtr) -> Number {
    if !vulkanHasDevice(context) { return 1 }
    let state = nativeRecover<GraphicsRuntimeState>(context)
    return vulkanWindowFor(vulkanWindowPlatformForHost()).scale(state.vulkan.window)
}

public function vulkanContextWidth(context: RawPtr) -> Number {
    if !vulkanHasDevice(context) { return 0 }
    return nativeRecover<GraphicsRuntimeState>(context).vulkan.swapchainWidth
}

public function vulkanContextHeight(context: RawPtr) -> Number {
    if !vulkanHasDevice(context) { return 0 }
    return nativeRecover<GraphicsRuntimeState>(context).vulkan.swapchainHeight
}

public function vulkanViewportWidth(context: RawPtr) -> Number {
    return Number(vulkanContextWidth(context)) / vulkanEffectiveWindowScale(context)
}

public function vulkanViewportHeight(context: RawPtr) -> Number {
    return Number(vulkanContextHeight(context)) / vulkanEffectiveWindowScale(context)
}

// The window's scale, or one where it reports none. A compositor that answers
// zero for the scale of a surface it has not mapped would otherwise divide a
// viewport by zero at the first frame.
public function vulkanEffectiveWindowScale(context: RawPtr) -> Number {
    let scale = vulkanWindowScale(context)
    if scale <= 0 { return 1 }
    return scale
}

public function vulkanWindowMode(context: RawPtr) -> WindowMode {
    if !vulkanHasDevice(context) { return .Windowed }
    let state = nativeRecover<GraphicsRuntimeState>(context)
    if targetPlatform!() == .Windows {
        return dawnReadWindowMode(state.vulkan.window)
    }
    return .Windowed
}

public function vulkanSetWindowMode(context: RawPtr, mode: borrow WindowMode) {
    if !vulkanHasDevice(context) || targetPlatform!() != .Windows { return }
    let state = nativeRecover<GraphicsRuntimeState>(context)
    dawnApplyWindowMode(state.vulkan.window, mode, state.app.windowRequest())
}

public function vulkanMinimizeWindow(context: RawPtr) {
    if targetPlatform!() == .Windows && vulkanHasDevice(context) {
        let runtime = nativeRecover<GraphicsRuntimeState>(context)
        showWindow(runtime.vulkan.window, I32(6))
    }
    if targetPlatform!() == .Linux && vulkanHasDevice(context) {
        let runtime = nativeRecover<GraphicsRuntimeState>(context)
        dawnWaylandMinimize(runtime)
    }
}

public function vulkanToggleMaximizeWindow(context: RawPtr) {
    if targetPlatform!() == .Windows && vulkanHasDevice(context) {
        let runtime = nativeRecover<GraphicsRuntimeState>(context)
        if dawnReadWindowMode(runtime.vulkan.window) == .Windowed {
            showWindow(runtime.vulkan.window, I32(3))
        } else {
            showWindow(runtime.vulkan.window, I32(9))
        }
    }
    if targetPlatform!() == .Linux && vulkanHasDevice(context) {
        let runtime = nativeRecover<GraphicsRuntimeState>(context)
        dawnWaylandToggleMaximize(runtime)
    }
}

public function vulkanShowMouse(context: RawPtr, show: Bool) {
    if !vulkanHasDevice(context) { return }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    if targetPlatform!() == .Windows && runtime.vulkan.mouseVisible != show {
        showCursor(show)
        runtime.vulkan.mouseVisible = show
    }
}

public function vulkanMouseShown(context: RawPtr) -> Bool {
    if !vulkanHasDevice(context) { return true }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    return runtime.vulkan.mouseVisible
}

public function vulkanLockMouse(context: RawPtr, lock: Bool) {
    if !vulkanHasDevice(context) || targetPlatform!() != .Windows { return }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    if runtime.vulkan.mouseLocked == lock { return }
    if !vulkanClipCursor(runtime.vulkan.window, lock) { return }
    runtime.vulkan.mouseLocked = lock
    vulkanShowMouse(context, !lock)
}

public function vulkanMouseLocked(context: RawPtr) -> Bool {
    if !vulkanHasDevice(context) { return false }
    return nativeRecover<GraphicsRuntimeState>(context).vulkan.mouseLocked
}

// `VkClearValue` is a C union of a colour and a depth-stencil pair; each is
// written over it as the struct it is.
public @FFI.Struct { layout: c }
struct VulkanClearColor {
    var red: F32
    var green: F32
    var blue: F32
    var alpha: F32
}

public function vulkanClearValue(color: borrow RGBAColor) -> VkClearValue {
    let value = boxed<VkClearValue>(VkClearValue())
    heapStore<VulkanClearColor>(
        value.pointer(),
        0,
        VulkanClearColor {
            red: F32(color.r),
            green: F32(color.g),
            blue: F32(color.b),
            alpha: F32(color.a)
        }
    )
    return boxedValue<VkClearValue>(value)
}

public function vulkanDepthClearValue(depth: Number, stencil: Number) -> VkClearValue {
    let value = boxed<VkClearValue>(VkClearValue())
    heapStore<VkClearDepthStencilValue>(
        value.pointer(),
        0,
        VkClearDepthStencilValue { depth: F32(depth), stencil: U32(stencil) }
    )
    return boxedValue<VkClearValue>(value)
}

// The size and sample count a managed depth target is made at.
public struct VulkanDepthExtent {
    let width: UN32 = 0
    let height: UN32 = 0
    let sampleCount: UN8 = 1
}

// The depth target a pass gets when it asks for depth without naming a
// texture, kept and reused while passes stay the same size.
public struct VulkanManagedDepth {
    let image: U32
    let view: U32
    let extent: VulkanDepthExtent
}

function vulkanManagedDepthFits(
    depth: borrow VulkanManagedDepth,
    extent: borrow VulkanDepthExtent
) -> Bool {
    return depth.extent.width == extent.width
        && depth.extent.height == extent.height
        && depth.extent.sampleCount == extent.sampleCount
}

public function vulkanReleaseManagedDepth(state: borrow mut VulkanState) {
    match state.managedDepth {
        Some(depth) -> {
            vulkanReleaseObject(state, depth.view)
            vulkanReleaseObject(state, depth.image)
        }
        None -> {}
    }
    state.managedDepth = .None
}

public function vulkanEnsureDepthTarget(
    state: borrow mut VulkanState,
    extent: borrow VulkanDepthExtent
) -> Result<VulkanManagedDepth, VulkanResourceFailure> {
    match state.managedDepth {
        Some(depth) -> if vulkanManagedDepthFits(depth, extent) {
            return .Ok(depth)
        }
        None -> {}
    }
    vulkanReleaseManagedDepth(state)
    let depth = match vulkanNewManagedDepth(state, extent) {
        Ok(depth) -> depth
        Error(failure) -> return .Error(failure)
    }
    state.managedDepth = .Some(depth)
    return .Ok(depth)
}

// A depth-stencil image and its view at the size and sample count a pass
// wants.
function vulkanNewManagedDepth(
    state: borrow mut VulkanState,
    extent: borrow VulkanDepthExtent
) -> Result<VulkanManagedDepth, VulkanResourceFailure> {
    let descriptor = TextureDescriptor {
        label: "kira-vulkan-managed-depth",
        width: extent.width,
        height: extent.height,
        format: .Depth24Stencil8,
        usage: .DepthStencil,
        sampleCount: extent.sampleCount,
        storage: .Transient
    }
    let image = match vulkanCreateImageHandle(state, descriptor) {
        Ok(image) -> image
        Error(failure) -> return .Error(failure)
    }
    let view = match vulkanCreateImageView(
        state,
        image,
        VulkanVocabulary.formatDepth24Stencil8,
        VulkanVocabulary.aspectDepth | VulkanVocabulary.aspectStencil
    ) {
        Ok(view) -> view
        Error(failure) -> {
            vulkanReleaseObject(state, image)
            return .Error(failure)
        }
    }
    return .Ok(VulkanManagedDepth { image: image, view: view, extent: copy extent })
}

public function vulkanWaitForFrame(state: borrow VulkanState) -> Result<Void, VulkanFrameFailure> {
    let fence = boxed<RawPtr>(state.inFlightFence)
    let waitResult = vulkanResultOf(
        vkWaitForFences(state.device, U32(1), fence.pointer(), U32(1), VulkanVocabulary.waitForever)
    )
    if waitResult != .Success {
        return .Error(.FenceWaitFailed(waitResult))
    }
    return .Ok
}

// A windowed frame open for recording, once the last one has retired.
public function vulkanAcquireFrame(
    state: borrow mut VulkanState
) -> Result<Void, VulkanFrameFailure> {
    match vulkanRetireFrame(state) {
        Ok -> {}
        Error(failure) -> return .Error(failure)
    }
    match vulkanRestartCommandBuffer(state, .Reused) {
        Ok -> {}
        Error(failure) -> return .Error(failure)
    }
    state.frameActive = true
    state.acquired = false
    state.acquireWaitPending = false
    state.dynamicFrame = state.dynamicFrame + 1
    return .Ok
}

// Waits for the next presentable image with no timeout, as the frame cannot
// continue without one.
function vulkanAcquireNextImage(
    state: borrow VulkanState,
    imageIndex: borrow Boxed<U32>
) -> VulkanResult {
    return vulkanResultOf(
        vkAcquireNextImageKHR(
            state.device,
            state.swapchain,
            VulkanVocabulary.waitForever,
            state.imageAvailable,
            nullPointer(),
            imageIndex.pointer()
        )
    )
}

// The swapchain image is taken only when a pass first draws to it. A frame
// that never does presents nothing, and the window keeps the image it showed
// last; presenting an image nothing was drawn into would show its undefined
// contents instead.
public function vulkanAcquireSwapchainImage(
    state: borrow mut VulkanState
) -> Result<Void, VulkanFrameFailure> {
    if state.acquired {
        return .Ok
    }
    if !state.frameActive {
        return .Error(.OutsideFrame)
    }
    let imageIndex = boxed<U32>(U32(0))
    var result = vulkanAcquireNextImage(state, imageIndex)
    if result == .OutOfDate {
        match vulkanRecreateSwapchain(state) {
            Ok -> {}
            Error(failure) -> return .Error(.SwapchainLost(failure))
        }
        result = vulkanAcquireNextImage(state, imageIndex)
    }
    if result != .Success && result != .Suboptimal {
        return .Error(.NoImage(result))
    }
    state.currentImageIndex = boxedValue<U32>(imageIndex)
    state.acquired = true
    state.acquireWaitPending = true
    return .Ok
}

public function vulkanReleasePendingUploads(state: borrow mut VulkanState) {
    for buffer in state.pendingUploadBuffers {
        vulkanReleaseObject(state, buffer)
    }
    state.pendingUploadBuffers = []
}

public function vulkanBeginRenderPass(context: RawPtr, frame: borrow RenderFrame) -> Bool {
    if !vulkanRequireDevice(context, "vulkanBeginRenderPass") {
        return false
    }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    return vulkanBeginRenderPassState(runtime.vulkan, frame)
}

public function vulkanEndPassAndCommit(context: RawPtr) {
    if !vulkanHasDevice(context) { return }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    vulkanEndPassAndCommitState(runtime.vulkan)
}

public function vulkanEndPassAndCommitState(state: borrow mut VulkanState) {
    if !state.passActive { return }
    vulkanEndRendering(state.device, state.commandBuffer)
    if !state.passIsSwapchain {
        vulkanReadyForSampling(state, state.passColorImage)
    }
    if !isNull(state.passResolveImage) {
        vulkanReadyForSampling(state, state.passResolveImage)
    }
    state.passActive = false
    state.passWidth = 0
    state.passHeight = 0
    state.passResolveImage = nullPointer()
    state.passSampleCount = 1
}

// A render target the pass drew into, moved to the layout a later pass or
// kernel samples it in.
function vulkanReadyForSampling(state: borrow mut VulkanState, image: RawPtr) {
    match vulkanImageId(state, image) {
        Some(imageId) -> vulkanTransitionImage(
            state,
            imageId,
            .ShaderRead,
            VulkanVocabulary.aspectColor
        )
        // A swapchain image is not in the table; its layout is tracked apart.
        None -> {}
    }
}

// The id of the registered image whose handle is `image`.
public function vulkanImageId(state: borrow VulkanState, image: RawPtr) -> U32? {
    for slot in 0..state.objects.count {
        match state.objects[slot] {
            Some(object) -> if object.kind == .Image && object.handle == image {
                return .Some(U32(slot + 1))
            }
            None -> {}
        }
    }
    return .None
}
