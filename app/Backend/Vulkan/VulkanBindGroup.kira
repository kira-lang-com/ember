import Foundation

// Bind groups are the CPU-side resource lists shared by every backend. Vulkan
// materializes a descriptor set only when a pipeline layout is known, during a
// draw; the list itself therefore needs no device handle here.

public function vulkanNewBindGroup(label: borrow String) -> BindGroup {
    return BindGroup {
        storage: nativeState(BindGroupState {
            label: label
        }),
        id: 1
    }
}

public function vulkanCreateBindGroup(context: RawPtr, descriptor: borrow BindGroupDescriptor) -> BindGroupResult {
    if !vulkanRequireDevice(context, "vulkanCreateBindGroup") {
        return .Error(.DeviceRefused)
    }
    let group = vulkanNewBindGroup(descriptor.label)
    var uniformIndex = 0
    while uniformIndex < descriptor.uniformEntries.count {
        vulkanBindGroupAddUniform(
            group,
            descriptor.uniformEntries[uniformIndex].uniformSlot,
            descriptor.uniformEntries[uniformIndex].uniform
        )
        uniformIndex = uniformIndex + 1
    }
    for entry in descriptor.textureEntries {
        vulkanBindGroupAddTexture(group, entry.textureSlot, entry.texture)
    }
    for entry in descriptor.samplerEntries {
        vulkanBindGroupAddSampler(group, entry.samplerSlot, entry.sampler)
    }
    return .Ok(group)
}

public function vulkanCreateUniformBindGroup(label: borrow String, uniformSlot: Int, uniform: borrow EMUniform) -> BindGroupResult {
    let group = vulkanNewBindGroup(label)
    vulkanBindGroupAddUniform(group, uniformSlot, uniform)
    return .Ok(group)
}

public function vulkanCreateStorageBufferBindGroup(label: borrow String, slot: Int, bufferId: U32) -> BindGroupResult {
    if slot < 0 || bufferId == 0 {
        return .Error(.DeviceRefused)
    }
    let group = vulkanNewBindGroup(label)
    var state = nativeRecover<BindGroupState>(group.storage)
    state.storageEntries.append(StorageBindEntry {
        storageSlot: slot,
        viewId: bufferId
    })
    state.revision = state.revision + 1
    return .Ok(group)
}

public function vulkanBeginBindGroup(label: borrow String) -> BindGroupResult {
    return .Ok(vulkanNewBindGroup(label))
}

public function vulkanBindGroupAddUniform(group: borrow BindGroup, slot: Int, uniform: borrow EMUniform) {
    if group.id == 0 || slot < 0 || uniform.id == 0 {
        return
    }
    var state = nativeRecover<BindGroupState>(group.storage)
    state.uniformEntries.append(StoredUniformBindEntry {
        uniformSlot: slot,
        uniformId: uniform.id,
        storage: nativeUserData(uniform.storage)
    })
    state.revision = state.revision + 1
    return
}

public function vulkanBindGroupAddTexture(group: borrow BindGroup, slot: Int, texture: borrow EMGraphicsTexture) {
    if slot < 0 || texture.viewId == 0 {
        return
    }
    var state = nativeRecover<BindGroupState>(group.storage)
    state.textureEntries.append(TextureBindEntry {
        textureSlot: slot,
        texture: texture
    })
    state.revision = state.revision + 1
    return
}

public function vulkanBindGroupAddSampler(group: borrow BindGroup, slot: Int, sampler: borrow EMGraphicsSampler) {
    if slot < 0 || sampler.id == 0 {
        return
    }
    var state = nativeRecover<BindGroupState>(group.storage)
    state.samplerEntries.append(SamplerBindEntry {
        samplerSlot: slot,
        sampler: sampler
    })
    state.revision = state.revision + 1
    return
}

public function vulkanCreateTextureSamplerBindGroup(label: borrow String, textureSlot: Int, texture: borrow EMGraphicsTexture, samplerSlot: Int, sampler: borrow EMGraphicsSampler) -> BindGroupResult {
    let group = vulkanNewBindGroup(label)
    vulkanBindGroupAddTexture(group, textureSlot, texture)
    vulkanBindGroupAddSampler(group, samplerSlot, sampler)
    return .Ok(group)
}

// Descriptor sets belong to the pipeline's descriptor pool, not to the public
// group value. EMGraphics releases the CPU state box after this member returns.
public function vulkanDestroyBindGroup(group: borrow BindGroup) {
    return
}
