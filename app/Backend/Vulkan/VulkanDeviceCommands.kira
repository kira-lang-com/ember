import Foundation
import Heap

// The device commands the loader does not export: dynamic rendering through
// its `KHR` names and the dma-buf export. Vulkan hands each out by name from
// `vkGetDeviceProcAddr` as a `PFN_vkVoidFunction` C casts to the command's own
// type; here each type the backend calls through has its own declaration of
// that symbol, which is the same cast, and Kira calls the answer through the
// pointer (KLF section 26.4).

@FFI.Callback { abi: c, params: [RawPtr, VkRenderingInfo_ptr], result: Void }
struct VulkanBeginRenderingCommand {}

@FFI.Callback { abi: c, params: [RawPtr], result: Void }
struct VulkanEndRenderingCommand {}

@FFI.Callback { abi: c, params: [RawPtr, VkMemoryGetFdInfoKHR_ptr, RawPtr], result: I32 }
struct VulkanGetMemoryFdCommand {}

// The address alone, to learn whether the device has the command at all.
@FFI.Extern { library: vulkan, symbol: vkGetDeviceProcAddr, abi: c }
function vulkanDeviceCommandAddress(device: RawPtr, name: CString) -> RawPtr

@FFI.Extern { library: vulkan, symbol: vkGetDeviceProcAddr, abi: c }
function vulkanBeginRenderingCommand(device: RawPtr, name: CString) -> VulkanBeginRenderingCommand

@FFI.Extern { library: vulkan, symbol: vkGetDeviceProcAddr, abi: c }
function vulkanEndRenderingCommand(device: RawPtr, name: CString) -> VulkanEndRenderingCommand

@FFI.Extern { library: vulkan, symbol: vkGetDeviceProcAddr, abi: c }
function vulkanGetMemoryFdCommand(device: RawPtr, name: CString) -> VulkanGetMemoryFdCommand

namespace VulkanDeviceCommand {
    let beginRendering: String = "vkCmdBeginRenderingKHR"
    let endRendering: String = "vkCmdEndRenderingKHR"
    let getMemoryFd: String = "vkGetMemoryFdKHR"
}

function vulkanHasDeviceCommand(device: RawPtr, name: borrow String) -> Bool {
    return !isNull(vulkanDeviceCommandAddress(device, name))
}

// Whether the device resolves both dynamic rendering commands, which every
// pass begins and ends with.
public function vulkanHasDynamicRendering(device: RawPtr) -> Bool {
    return vulkanHasDeviceCommand(device, VulkanDeviceCommand.beginRendering)
        && vulkanHasDeviceCommand(device, VulkanDeviceCommand.endRendering)
}

// The device was refused at creation unless it has both commands, so the
// lookups here always answer one.
public function vulkanBeginRendering(device: RawPtr, commandBuffer: RawPtr, info: VkRenderingInfo) {
    let begin = vulkanBeginRenderingCommand(device, VulkanDeviceCommand.beginRendering)
    begin(commandBuffer, info)
}

public function vulkanEndRendering(device: RawPtr, commandBuffer: RawPtr) {
    let end = vulkanEndRenderingCommand(device, VulkanDeviceCommand.endRendering)
    end(commandBuffer)
}

// Whether the device can hand an allocation's memory out as a dma-buf: only
// on a Linux kernel, and only when the driver resolves the export command.
public function vulkanMemoryExportSupported(device: RawPtr) -> Bool {
    return vulkanKernelDmaBuf() && vulkanHasDeviceCommand(device, VulkanDeviceCommand.getMemoryFd)
}

// A new dma-buf descriptor for `memory`, owned by the caller, or nothing when
// the device has no export or the driver refuses this memory.
public function vulkanGetMemoryFd(device: RawPtr, memory: RawPtr) -> Optional<I32> {
    if !vulkanMemoryExportSupported(device) { return .None }
    let get = vulkanGetMemoryFdCommand(device, VulkanDeviceCommand.getMemoryFd)
    let descriptor = boxed<I32>(I32(-1))
    let info = VkMemoryGetFdInfoKHR {
        sType: I32(VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR),
        memory: memory,
        handleType: I32(VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT)
    }
    if get(device, info, descriptor.pointer()) != I32(VK_SUCCESS) { return .None }
    return .Some(boxedValue<I32>(descriptor))
}

// Whether the kernel under the build shares memory as dma-bufs: Linux's, which
// Tessera runs on too.
function vulkanKernelDmaBuf() -> Bool {
    return match targetPlatform!() {
        Linux, Tessera -> true
        else -> false
    }
}
