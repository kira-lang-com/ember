import Foundation
import Heap

// Device buffers, uniforms and samplers.
//
// Buffers use host-visible memory, so the CPU upload contract the whole surface
// has is a direct write rather than a staging submission. A uniform is a buffer
// whose layout a shader's reflection already fixed; a sampler is the descriptor
// a texture is read through.
//
// Images and textures are in `VulkanTexture.kira`, which is the other half of
// this and a different problem: an optimal-tiled image cannot be written
// directly, so every one of those uploads is a short transfer submission first.

// Where every per-frame buffer keeps one slot per frame in flight.
namespace VulkanFrameRing {
    let slots: UNumber = 3
    // `minUniformBufferOffsetAlignment` is at most 256 on every device.
    let slotAlignment: UNumber = 256
    // Every usage a dynamic buffer may be bound at, because its caller does not
    // say: the same stream is a vertex buffer in one pipeline and a storage
    // array in the next.
    let dynamicUsage: U32 = VulkanVocabulary.bufferUsageVertex
        | VulkanVocabulary.bufferUsageIndex
        | VulkanVocabulary.bufferUsageStorage
        | VulkanVocabulary.bufferUsageUniform
        | VulkanVocabulary.bufferUsageTransferSource
        | VulkanVocabulary.bufferUsageTransferDestination
}

// A host-visible, coherent buffer, or nothing where the device refused one.
// Logs why.
function vulkanHostBuffer(
    state: borrow mut VulkanState,
    request: borrow VulkanBufferRequest
) -> U32? {
    match vulkanCreateBufferHandle(state, request) {
        Ok(id) -> return .Some(id)
        Error(failure) -> {
            log fault("could not create a buffer", failure, label: request.label)
            return .None
        }
    }
}

// A buffer with one slot per frame in flight, each `floatCount` floats long.
struct VulkanRingBuffer {
    let id: U32
    let slotSize: UNumber
    let totalSize: UNumber
}

// A ring of host-visible slots, or nothing where the device refused it. Logs
// why.
function vulkanNewRingBuffer(
    state: borrow mut VulkanState,
    label: borrow String,
    usage: U32,
    floatCount: UNumber
) -> VulkanRingBuffer? {
    let slotSize = vulkanAligned(floatCount * sizeOf<F32>(), VulkanFrameRing.slotAlignment)
    let request = VulkanBufferRequest {
        label: label,
        usage: usage,
        byteSize: slotSize * VulkanFrameRing.slots
    }
    let id = match vulkanHostBuffer(state, request) {
        Some(id) -> id
        None -> return .None
    }
    vulkanSetObjectStride(state, id, slotSize)
    return .Some(VulkanRingBuffer { id: id, slotSize: slotSize, totalSize: request.byteSize })
}

public function vulkanAligned(value: Number, alignment: Number) -> Number {
    if value <= 0 {
        return alignment
    }
    return alignedUp(value, alignment)
}

public function vulkanCreateBuffer(
    context: RawPtr,
    descriptor: borrow BufferDescriptor
) -> BufferResult {
    if !vulkanRequireDevice(context, "vulkanCreateBuffer") {
        return .Error(.DeviceRefused)
    }
    if descriptor.data.count <= 0 {
        log fault("a vertex buffer was created with no data; Vulkan cannot make an empty buffer")
        return .Error(.DeviceRefused)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let byteCount = descriptor.data.count * sizeOf<F32>()
    let request = VulkanBufferRequest {
        label: descriptor.label,
        usage: vulkanBufferUsage(descriptor.usage),
        byteSize: byteCount
    }
    let id = match vulkanHostBuffer(state.vulkan, request) {
        Some(id) -> id
        None -> return .Error(.DeviceRefused)
    }
    vulkanWriteFloats(state.vulkan, id, narrowFloats(descriptor.data), 0)
    return .Ok(GraphicsBuffer { id: BufferId(id), byteSize: byteCount })
}

public function vulkanCreateIndexBuffer(
    context: RawPtr,
    descriptor: borrow IndexBufferDescriptor
) -> BufferResult {
    if !vulkanRequireDevice(context, "vulkanCreateIndexBuffer") {
        return .Error(.DeviceRefused)
    }
    if descriptor.data.count <= 0 {
        log fault("an index buffer was created with no data")
        return .Error(.DeviceRefused)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let byteCount = descriptor.data.count * sizeOf<U32>()
    let request = VulkanBufferRequest {
        label: descriptor.label,
        usage: vulkanBufferUsage(.Index),
        byteSize: byteCount
    }
    let id = match vulkanHostBuffer(state.vulkan, request) {
        Some(id) -> id
        None -> return .Error(.DeviceRefused)
    }
    vulkanWriteWords(state.vulkan, id, narrowWords(descriptor.data))
    return .Ok(GraphicsBuffer { id: BufferId(id), byteSize: byteCount })
}

public function vulkanCreateStorageBufferWords(
    context: RawPtr,
    label: borrow String,
    data: borrow[U32]
) -> BufferResult {
    if !vulkanRequireDevice(context, "vulkanCreateStorageBufferWords") {
        return .Error(.DeviceRefused)
    }
    if data.count <= 0 {
        log fault("a storage buffer was created with no data", label: label)
        return .Error(.DeviceRefused)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let byteCount = data.count * sizeOf<U32>()
    let request = VulkanBufferRequest {
        label: label,
        usage: vulkanBufferUsage(.Storage),
        byteSize: byteCount
    }
    let id = match vulkanHostBuffer(state.vulkan, request) {
        Some(id) -> id
        None -> return .Error(.DeviceRefused)
    }
    vulkanWriteWords(state.vulkan, id, data)
    return .Ok(GraphicsBuffer { id: BufferId(id), byteSize: byteCount })
}

public function vulkanCreateDynamicBuffer(
    context: RawPtr,
    label: borrow String,
    floatCapacity: Number
) -> DynamicBufferResult {
    if !vulkanRequireDevice(context, "vulkanCreateDynamicBuffer") {
        return .Error(.DeviceRefused)
    }
    if floatCapacity <= 0 {
        log fault(
            "a dynamic buffer was created with no capacity",
            label: label,
            floatCapacity: floatCapacity
        )
        return .Error(.DeviceRefused)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let ring = match vulkanNewRingBuffer(
        state.vulkan,
        label,
        VulkanFrameRing.dynamicUsage,
        floatCapacity
    ) {
        Some(ring) -> ring
        None -> return .Error(.DeviceRefused)
    }
    return vulkanMappedDynamicBuffer(state.vulkan, ring, label)
}

// The ring as a dynamic buffer, with the host-visible memory the CPU writes
// into. A ring whose memory did not map is released rather than handed back.
function vulkanMappedDynamicBuffer(
    state: borrow mut VulkanState,
    ring: borrow VulkanRingBuffer,
    label: borrow String
) -> DynamicBufferResult {
    let contents = match vulkanObjectMapped(state, ring.id) {
        Some(contents) -> contents
        None -> {
            log fault("a dynamic buffer's host-visible memory was not mapped", label: label)
            vulkanReleaseObject(state, ring.id)
            return .Error(.DeviceRefused)
        }
    }
    let buffer = GraphicsBuffer { id: BufferId(ring.id), byteSize: ring.totalSize }
    return .Ok(DynamicBuffer { buffer: buffer, contents: contents })
}

public function vulkanDynamicBufferFrameStart(
    context: RawPtr,
    buffer: borrow GraphicsBuffer
) -> Number {
    if !vulkanRequireDevice(context, "vulkanDynamicBufferFrameStart") {
        return 0
    }
    if buffer.id == 0 {
        log fault("a dynamic buffer that was never created (id 0) was used")
        return 0
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let stride = vulkanObjectStride(state.vulkan, buffer.id.raw)
    let slot = state.vulkan.dynamicFrame % VulkanFrameRing.slots
    let offset = stride * slot
    vulkanSetObjectOffset(state.vulkan, buffer.id.raw, offset)
    return offset
}

public function vulkanCreateUniform(
    context: RawPtr,
    descriptor: borrow UniformDescriptor
) -> UniformResult {
    if !vulkanRequireDevice(context, "vulkanCreateUniform") {
        return .Error(.DeviceRefused)
    }
    if descriptor.expectedFloatCount <= 0 || descriptor.data.count != descriptor.expectedFloatCount {
        log fault(
            "a uniform was given a different number of floats than it declared",
            expectedFloatCount: descriptor.expectedFloatCount,
            count: descriptor.data.count
        )
        return .Error(.DeviceRefused)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let ring = match vulkanNewRingBuffer(
        state.vulkan,
        descriptor.label,
        VulkanVocabulary.bufferUsageUniform,
        descriptor.expectedFloatCount
    ) {
        Some(ring) -> ring
        None -> return .Error(.DeviceRefused)
    }
    let id = ring.id
    vulkanWriteFloats(state.vulkan, id, narrowFloats(descriptor.data), 0)
    return .Ok(
        GraphicsUniform {
            storage: nativeState(
                UniformState {
                    label: descriptor.label,
                    expectedFloatCount: descriptor.expectedFloatCount,
                    values: descriptor.data
                }
            ),
            id: UniformId(id)
        }
    )
}

public function vulkanUpdateUniform(
    context: RawPtr,
    uniform: borrow GraphicsUniform,
    data: borrow[Number]
) {
    if !vulkanRequireDevice(context, "vulkanUpdateUniform") {
        return
    }
    if uniform.id == 0 {
        log fault("a uniform that was never created (id 0) was updated")
        return
    }
    var uniformState = nativeRecover<UniformState>(uniform.storage)
    if data.count != uniformState.expectedFloatCount {
        log fault("uniform update size does not match its declaration")
        return
    }
    uniformState.values = data
}

public function vulkanCreateSampler(
    context: RawPtr,
    descriptor: borrow SamplerDescriptor
) -> SamplerResult {
    if !vulkanRequireDevice(context, "vulkanCreateSampler") {
        return .Error(.DeviceRefused)
    }
    var state = nativeRecover<GraphicsRuntimeState>(context)
    let info = VkSamplerCreateInfo {
        sType: VulkanVocabulary.structureSamplerCreateInfo,
        magFilter: vulkanSamplerFilter(descriptor.magFilter),
        minFilter: vulkanSamplerFilter(descriptor.minFilter),
        mipmapMode: VulkanVocabulary.mipmapNearest,
        addressModeU: vulkanAddressMode(descriptor.addressModeU),
        addressModeV: vulkanAddressMode(descriptor.addressModeV),
        addressModeW: VulkanVocabulary.samplerAddressClamp,
        maxAnisotropy: 1.0,
        maxLod: 1.0
    }
    let samplerSlot = boxed<RawPtr>(nullPointer())
    let result = vulkanResultOf(
        vkCreateSampler(state.vulkan.device, info, nullPointer(), samplerSlot.pointer())
    )
    let sampler = boxedValue<RawPtr>(samplerSlot)
    if result != .Success || isNull(sampler) {
        log fault("could not create sampler", label: descriptor.label, result: result)
        return .Error(.DeviceRefused)
    }
    let id = vulkanRegisterObject(state.vulkan, VulkanObject { kind: .Sampler, handle: sampler })
    return .Ok(GraphicsSampler { id: SamplerId(id) })
}
