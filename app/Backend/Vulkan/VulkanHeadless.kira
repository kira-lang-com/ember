import Foundation
import Heap

// Vulkan device and command-buffer lifecycle for renderers with no native
// window or swapchain. Offscreen passes use the same texture, pipeline and
// encoder implementation as the windowed backend; only acquire/present differ.

public function vulkanCreateHeadlessDevice(
    runtime: borrow mut GraphicsRuntimeState
) -> Result<Void, VulkanSetupFailure> {
    runtime.vulkan = VulkanState()
    match vulkanSetUpHeadless(runtime.vulkan) {
        Ok -> {}
        Error(failure) -> {
            vulkanShutdownState(runtime.vulkan)
            return .Error(failure)
        }
    }
    runtime.vulkan.initialized = true
    return .Ok
}

public function vulkanBeginHeadlessFrame(
    state: borrow mut VulkanState
) -> Result<Void, VulkanFrameFailure> {
    if state.frameActive {
        return .Ok
    }
    match vulkanRetireFrame(state) {
        Ok -> {}
        Error(failure) -> return .Error(failure)
    }
    match vulkanRestartCommandBuffer(state, .OneTime) {
        Ok -> {}
        Error(failure) -> return .Error(failure)
    }
    state.frameActive = true
    state.acquired = false
    state.acquireWaitPending = false
    state.dynamicFrame = state.dynamicFrame + 1
    state.frameStartedAt = vulkanMonotonicNanoseconds()
    state.framePassCount = 0
    state.frameDrawCount = 0
    state.frameTriangleCount = 0
    return .Ok
}

public function vulkanSubmitHeadlessFrame(context: RawPtr) {
    if !vulkanRequireDevice(context, "vulkanSubmitHeadlessFrame") { return }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    if !runtime.vulkan.frameActive { return }
    if runtime.vulkan.passActive { vulkanEndPassAndCommitState(runtime.vulkan) }
    match vulkanSubmitFrameCommands(runtime.vulkan, .None) {
        Ok -> {}
        Error(failure) -> {
            log fault("could not submit its headless frame", failure)
            runtime.vulkan.frameActive = false
            return
        }
    }
    match vulkanWaitForFrame(runtime.vulkan) {
        Ok -> {}
        Error(failure) -> {
            log fault("a headless submission did not complete", failure)
            runtime.vulkan.frameActive = false
            return
        }
    }
    runtime.vulkan.frameActive = false
    vulkanRecordHeadlessStats(runtime.vulkan)
}

function vulkanRecordHeadlessStats(state: borrow mut VulkanState) {
    let elapsed = secondsFromNanoseconds(vulkanMonotonicNanoseconds() - state.frameStartedAt)
    state.stats.frameSeconds = elapsed
    state.stats.cpuSeconds = elapsed
    state.stats.allocatedBytes = state.allocatedBytes
    state.stats.hasAllocatedBytes = true
    state.stats.resourceCount = state.resourceCount
    state.stats.passCount = state.framePassCount
    state.stats.drawCount = state.frameDrawCount
    state.stats.triangleCount = state.frameTriangleCount
    state.stats.framesInFlight = 1
    state.stats.frameSerial = state.stats.frameSerial + 1
}

public function vulkanPrepareHeadlessFrame(context: RawPtr) -> Result<Void, VulkanFrameFailure> {
    if !vulkanHasDevice(context) {
        return .Error(.NoDevice)
    }
    var runtime = nativeRecover<GraphicsRuntimeState>(context)
    return vulkanBeginHeadlessFrame(runtime.vulkan)
}
