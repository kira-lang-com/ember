import Ember
import Foundation

namespace Panel {
    // Three quads, two triangles each.
    let vertexCount: UN32 = 18
    // Two floats a vertex.
    let stride: UN32 = 8
}

function panelVertices() -> [Number] {
    return [-0.44, -0.24, 0.44, -0.24, 0.44, 0.24, -0.44, -0.24, 0.44, 0.24, -0.44, 0.24, -0.28, 0.06, 0.28, 0.06, 0.28, 0.12, -0.28, 0.06, 0.28, 0.12, -0.28, 0.12, -0.28, -0.08, 0.16, -0.08, 0.16, -0.02, -0.28, -0.08, 0.16, -0.02, -0.28, -0.02]
}

function panelVertexLayout() -> VertexLayout {
    return VertexLayout {
        stride: Panel.stride,
        attributes: [VertexAttribute { name: "position", format: .Float2 }]
    }
}

// What the frame draws with, made once at init and destroyed at cleanup.
struct PanelResources {
    var shader: GraphicsShader
    var pipeline: RenderPipeline
    var vertices: GraphicsBuffer
}

// None until init has made the resources, and None for good when it could not:
// a frame then clears and draws nothing.
struct PanelState {
    var resources: PanelResources? = .None
}

function panelPipeline(shader: borrow GraphicsShader) -> RenderPipelineDescriptor {
    return RenderPipelineDescriptor {
        label: "ui-demo-pipeline",
        shader: copy shader,
        vertexLayout: panelVertexLayout(),
        colorTargets: [ColorTargetDescriptor { blend: BlendState { preset: .Replace } }],
        depthStencil: DepthStencilDescriptor { depthCompare: .Always }
    }
}

function panelResources(graphics: borrow Graphics) -> Result<PanelResources, ResourceFailure> {
    let shader = match graphics.createShader(
        ShaderDescriptor {
            label: "ui-demo-shader",
            vertexPath: "generated/shaders/UiDemo.vert.glsl",
            fragmentPath: "generated/shaders/UiDemo.frag.glsl"
        }
    ) {
        Ok(shader) -> shader
        Error(failure) -> return .Error(failure)
    }
    let vertices = match graphics.createBuffer(
        BufferDescriptor { label: "ui-demo-vertices", data: panelVertices() }
    ) {
        Ok(buffer) -> buffer
        Error(failure) -> return .Error(failure)
    }
    return match graphics.createRenderPipeline(panelPipeline(shader)) {
        Ok(pipeline) -> .Ok(
            PanelResources { shader: shader, pipeline: pipeline, vertices: vertices }
        )
        Error(failure) -> .Error(failure)
    }
}

function panelInit(graphics: Graphics) {
    var state = nativeRecover<PanelState>(graphics.userData)
    match panelResources(graphics) {
        Ok(resources) -> state.resources = .Some(move resources)
        Error(failure) -> reportMissingResource("the panel", move failure)
    }
}

function panelFrame(frame: borrow mut RenderFrame) {
    let state = nativeRecover<PanelState>(frame.userData)
    let encoder = frame.beginRenderPass(
        clearSwapchainRenderPass(RGBAColor { r: 0.05, g: 0.06, b: 0.08 })
    )
    match state.resources {
        Some(resources) -> {
            encoder.setPipeline(resources.pipeline)
            encoder.setVertexBuffer(resources.vertices)
            encoder.draw(Panel.vertexCount)
        }
        None -> {}
    }
    frame.endPass()
}

function panelCleanup(graphics: Graphics) {
    let state = nativeRecover<PanelState>(graphics.userData)
    match state.resources {
        Some(resources) -> {
            graphics.destroyBuffer(resources.vertices)
            graphics.destroyRenderPipeline(resources.pipeline)
            graphics.destroyShader(copy resources.shader)
        }
        None -> {}
    }
}

@Main
function main() {
    var app = GraphicsApplication {
        title: "Ember UI Demo",
        width: 640,
        height: 480,
        sampleCount: 1,
        initHandler: panelInit,
        frameHandler: panelFrame,
        cleanupHandler: panelCleanup
    }
    app.run(nativeUserData(nativeState(PanelState())))
}
