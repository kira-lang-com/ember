import Ember
import Foundation

// A real triangle through the from-scratch Metal backend (no shim): MSL shader
// compiled at runtime, an MTLRenderPipelineState, a vertex MTLBuffer and a draw,
// all driven from Kira via the Objective-C runtime. Rendered into a CAMetalLayer
// drawable; the backend reads the center pixel back so the run proves the triangle
// rasterized (center = triangle color, not the clear color).

// What the frame draws with, made once at init.
struct TriangleResources {
    var pipeline: RenderPipeline
    var vertices: GraphicsBuffer
}

// None until init has made the resources, and None for good when it could not:
// a frame then clears and draws nothing.
struct TriangleState {
    var resources: TriangleResources? = .None
}

namespace Triangle {
    let vertexCount: UN32 = 3
    // Two floats a vertex.
    let stride: UN32 = 8
}

function triangleVertices() -> [Number] {
    return [0.0, 0.7, 0.7, -0.7, -0.7, -0.7]
}

function triangleSource() -> String {
    return "#include <metal_stdlib>\nusing namespace metal;\nstruct VOut { float4 pos [[position]]; };\nvertex VOut v_main(uint vid [[vertex_id]], constant float2* verts [[buffer(0)]]) { VOut o; o.pos = float4(verts[vid], 0.0, 1.0); return o; }\nfragment float4 f_main() { return float4(1.0, 0.4, 0.1, 1.0); }\n"
}

function trianglePipeline(shader: GraphicsShader) -> RenderPipelineDescriptor {
    return RenderPipelineDescriptor {
        label: "metal-triangle-pipeline",
        shader: shader,
        vertexLayout: VertexLayout {
            stride: Triangle.stride,
            attributes: [VertexAttribute { name: "position", format: .Float2 }]
        },
        colorTargets: [ColorTargetDescriptor { blend: BlendState { preset: .Replace } }],
        depthStencil: DepthStencilDescriptor { depthCompare: .Always }
    }
}

function triangleResources(
    graphics: borrow Graphics
) -> Result<TriangleResources, ResourceFailure> {
    let shader = match graphics.createShader(
        ShaderDescriptor { label: "metal-triangle-shader", vertexSource: triangleSource() }
    ) {
        Ok(shader) -> shader
        Error(failure) -> return .Error(failure)
    }
    let vertices = match graphics.createBuffer(
        BufferDescriptor { label: "metal-triangle-vertices", data: triangleVertices() }
    ) {
        Ok(buffer) -> buffer
        Error(failure) -> return .Error(failure)
    }
    return match graphics.createRenderPipeline(trianglePipeline(move shader)) {
        Ok(pipeline) -> .Ok(TriangleResources { pipeline: pipeline, vertices: vertices })
        Error(failure) -> .Error(failure)
    }
}

function triangleInit(graphics: Graphics) {
    var state = nativeRecover<TriangleState>(graphics.userData)
    match triangleResources(graphics) {
        Ok(resources) -> state.resources = .Some(move resources)
        Error(failure) -> reportMissingResource("the triangle", move failure)
    }
}

function triangleFrame(frame: borrow mut RenderFrame) {
    let state = nativeRecover<TriangleState>(frame.userData)
    let encoder = frame.beginRenderPass(
        clearSwapchainRenderPass(RGBAColor { r: 0.05, g: 0.05, b: 0.10 })
    )
    match state.resources {
        Some(resources) -> {
            encoder.setPipeline(resources.pipeline)
            encoder.setVertexBuffer(resources.vertices)
            encoder.draw(Triangle.vertexCount)
        }
        None -> {}
    }
    frame.endPass()
}

@Main
function main() {
    var app = GraphicsApplication {
        title: "Ember Metal Triangle",
        width: 480,
        height: 480,
        sampleCount: 1,
        backend: .Metal,
        initHandler: triangleInit,
        frameHandler: triangleFrame
    }
    app.run(nativeUserData(nativeState(TriangleState())))
}
