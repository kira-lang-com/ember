// One triangle covering the whole target, in one flat colour.

type VertexIn {
    @builtin(vertex_index)
    let vid: UInt
}

type VertexOut {
    @builtin(position)
    let clip_position: Float4
}

type FragmentOut {
    let color: Float4
}

shader Flat {
    vertex {
        input VertexIn
        output VertexOut

        function entry(input: VertexIn) -> VertexOut {
            let x = -1.0
            if input.vid == UInt(1) {
                x = 3.0
            }
            let y = -1.0
            if input.vid == UInt(2) {
                y = 3.0
            }
            let out: VertexOut
            out.clip_position = Float4(x, y, 0.0, 1.0)
            return out
        }
    }

    fragment {
        input VertexOut
        output FragmentOut

        function entry(input: VertexOut) -> FragmentOut {
            let result: FragmentOut
            result.color = Float4(1.0, 0.4, 0.1, 1.0)
            return result
        }
    }
}
