import Foundation
import Ember

construct VkCompositeAlphaUsesSupportedBits() extends Test {
    test {
        var capabilities = VkSurfaceCapabilitiesKHR()
        for bit in[1, 2, 4, 8] {
            capabilities.supportedCompositeAlpha = U32(bit)
            if Number(vulkanCompositeAlpha(capabilities)) != bit { return false }
        }
        return true
    }
    expect { return .Ok(true) }
}

construct VkSampleCountsMapToVulkanFlags() extends Test {
    test {
        for samples in[1, 2, 4, 8, 16, 32, 64] {
            match vulkanSampleCount(samples) {
                Some(flag) -> if Number(flag) != samples { return false }
                None -> return false
            }
        }
        return vulkanSampleCount(0) == .None && vulkanSampleCount(3) == .None
    }
    expect { return .Ok(true) }
}

construct VkDynamicOffsetsFollowBindingOrder() extends Test {
    test {
        // Reflection stores uniforms before storage buffers. Vulkan orders
        // dynamic offsets by binding number across both resource categories.
        let reflection = kslParseResourceReflection("u|later:7:16:1:0::;s|earlier:2:1:2:0")
        let bindings = vulkanDescriptorBindings(reflection, 0)
        return bindings.count == 2 && Number(bindings[0].binding) == 2 && Number(
            bindings[1].binding
        ) == 7
    }
    expect { return .Ok(true) }
}

construct VkSpirvRejectsMalformedHex() extends Test {
    test {
        return vulkanSpirvWords("123").count == 0 && vulkanSpirvWords("0000000g").count == 0
    }
    expect { return .Ok(true) }
}

construct VkSpirvPreservesWordBits() extends Test {
    test {
        let words = vulkanSpirvWords("07230203ffffffff80000000")
        return words.count == 3 && Number(words[0]) == 119734787 && Number(words[1]) == 4294967295
            && Number(words[2]) == 2147483648
    }
    expect { return .Ok(true) }
}
